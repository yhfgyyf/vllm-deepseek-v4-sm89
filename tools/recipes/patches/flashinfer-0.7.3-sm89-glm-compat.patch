+    _trtllm_batch_decode_sparse_mla_dsv4_sm120,
+    _trtllm_batch_decode_sparse_mla_v32_sm120,
+)
+
+
+def decode_dsv4(
+    *, query, swa_kv_cache, workspace_buffer, sparse_indices,
+    compressed_kv_cache=None, swa_topk_lens=None,
+    extra_sparse_indices=None, extra_sparse_topk_lens=None,
+    out=None, bmm1_scale=1.0, bmm2_scale=1.0, sinks=None, kv_layout="HND",
+):
+    return _trtllm_batch_decode_sparse_mla_dsv4_sm120(
+        query=query, swa_kv_cache=swa_kv_cache,
+        workspace_buffer=workspace_buffer, sparse_indices=sparse_indices,
+        compressed_kv_cache=compressed_kv_cache, swa_topk_lens=swa_topk_lens,
+        extra_sparse_indices=extra_sparse_indices,
+        extra_sparse_topk_lens=extra_sparse_topk_lens, out=out,
+        bmm1_scale=bmm1_scale, bmm2_scale=bmm2_scale, sinks=sinks, kv_layout=kv_layout,
+    )
+
+
+def decode_mla(
+    *, query, kv_cache, workspace_buffer, qk_nope_head_dim, kv_lora_rank,
+    qk_rope_head_dim, block_tables, seq_lens, max_seq_len, out,
+    bmm1_scale, bmm2_scale, sparse_mla_top_k, kv_scale_format,
+):
+    return _trtllm_batch_decode_sparse_mla_v32_sm120(
+        query=query, kv_cache=kv_cache, workspace_buffer=workspace_buffer,
+        qk_nope_head_dim=qk_nope_head_dim, kv_lora_rank=kv_lora_rank,
+        qk_rope_head_dim=qk_rope_head_dim, block_tables=block_tables,
+        seq_lens=seq_lens, sparse_mla_top_k_lens=None,
+        sparse_mla_top_k=sparse_mla_top_k, out=out,
+        bmm1_scale=bmm1_scale, bmm2_scale=bmm2_scale, sinks=None,
+        skip_softmax_threshold_scale_factor=None, uses_shared_paged_kv_idx=True,
+        lse=None, return_lse=False, kv_scale_format=kv_scale_format,
+    )
