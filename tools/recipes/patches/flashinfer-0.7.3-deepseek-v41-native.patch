+def test_v41_attention_reads_last_row_with_padded_strides(
+    compress_ratio, global_page_size
+):
+    device = torch.device("cuda")
+    prefix = 64
+    swa_row_stride = 544
+    swa_page_stride = 32 * swa_row_stride + 128
+    swa_backing = torch.zeros(
+        prefix + swa_page_stride, dtype=torch.uint8, device=device
+    )
+    swa_cache = swa_backing.as_strided(
+        (1, 32, swa_row_stride),
+        (swa_page_stride, swa_row_stride, 1),
+        storage_offset=prefix,
+    )
+    global_row_stride = 304
+    global_page_stride = global_page_size * global_row_stride + 128
+    global_backing = torch.zeros(
+        prefix + 2 * global_page_stride, dtype=torch.uint8, device=device
+    )
+    global_cache = global_backing.as_strided(
+        (2, global_page_size, global_row_stride),
+        (global_page_stride, global_row_stride, 1),
+        storage_offset=prefix,
+    )
+    assert global_page_size == 128 // compress_ratio
+    swa_kv = torch.linspace(-1, 1, 512, dtype=torch.bfloat16, device=device)[None]
+    global_kv = torch.stack(
+        (
+            torch.linspace(1, -1, 512, dtype=torch.bfloat16, device=device),
+            torch.linspace(-0.5, 0.75, 512, dtype=torch.bfloat16, device=device),
+            torch.linspace(0.25, -1, 512, dtype=torch.bfloat16, device=device),
+        )
+    )
+    deepseek_v41_pack_swa_cache(
+        swa_kv,
+        torch.tensor([31], dtype=torch.int32, device=device),
+        swa_cache,
+    )
+    deepseek_v41_pack_global_cache(
+        global_kv,
+        torch.tensor(
+            [global_page_size - 1, global_page_size, 2 * global_page_size - 1],
+            dtype=torch.int64,
+            device=device,
+        ),
+        global_cache,
+    )
+    swa_slots = torch.tensor([[31]], dtype=torch.int32, device=device)
+    global_slots = torch.tensor(
+        [[global_page_size - 1, global_page_size, 2 * global_page_size - 1]],
+        dtype=torch.int64,
+        device=device,
+    )
+    q = torch.ones(1, 8, 512, dtype=torch.bfloat16, device=device)
+    actual = deepseek_v41_mixed_sparse_attention(
+        q,
+        swa_cache,
+        global_cache,
+        swa_slots,
+        global_slots,
+        512**-0.5,
+    )
+
+    swa_decoded = _decode_swa(swa_cache[0, 31, :528][None])
+    global_rows = _gather(
+        global_cache,
+        global_slots,
+        global_page_size,
+        global_page_stride,
+        global_row_stride,
+        288,
+    )[0]
+    global_decoded = _decode_global(global_rows)
+    kv = torch.cat((swa_decoded, global_decoded)).to(torch.bfloat16)
+    logits = q[0].float() @ kv.float().T * (512**-0.5)
+    probabilities = logits.softmax(dim=1).to(torch.bfloat16)
+    expected = (probabilities.float() @ kv.float()).to(torch.bfloat16)
+    torch.testing.assert_close(actual[0], expected, rtol=3e-2, atol=3e-2)
