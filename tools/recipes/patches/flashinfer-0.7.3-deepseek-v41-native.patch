+"""JIT builders for DeepSeek-V4.1 mixed sparse kernels."""
+
+from . import env as jit_env
+from .core import JitSpec, current_compilation_context, gen_jit_spec
+
+
+def _deepseek_v41_arch_flags() -> list[str]:
+    archs = []
+    for major, minor in current_compilation_context.TARGET_CUDA_ARCHS:
+        normalized_minor = str(minor).lower().removesuffix("a").removesuffix("f")
+        if (major, normalized_minor) in ((8, "9"), (12, "0")):
+            archs.append((major, minor))
+    if not archs:
+        raise RuntimeError("DeepSeek-V4.1 sparse kernels require SM89 or SM120")
+    return [
+        f"-gencode=arch=compute_{major}{minor},code=sm_{major}{minor}"
+        for major, minor in archs
+    ] + current_compilation_context.COMMON_NVCC_FLAGS
+
+
+def gen_deepseek_v41_cache_module() -> JitSpec:
+    return gen_jit_spec(
+        "deepseek_v41_mixed_sparse_cache_v1",
+        [jit_env.FLASHINFER_CSRC_DIR / "deepseek_v41_cache.cu"],
+        extra_cuda_cflags=_deepseek_v41_arch_flags(),
+    )
+
+
+def gen_deepseek_v41_attention_module() -> JitSpec:
+    return gen_jit_spec(
+        "deepseek_v41_mixed_sparse_attention_cuda_v1",
+        [jit_env.FLASHINFER_CSRC_DIR / "deepseek_v41_attention.cu"],
+        extra_cuda_cflags=_deepseek_v41_arch_flags(),
+    )
