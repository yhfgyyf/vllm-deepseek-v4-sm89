+def _decode_dsv4_init_q(shapes, dtype, device):
+    """bf16 q ~ N(0, 0.1) clamped to [-1, 1] — matches the unit test distribution."""
+    return (
+        (torch.randn(shapes, device=device, dtype=torch.float32) / 10.0)
+        .clamp(-1, 1)
