+def _check_no_storage_alias(
+    grouped_out: torch.Tensor, operands: tuple[tuple[str, torch.Tensor], ...]
+) -> None:
+    grouped_storage = grouped_out.untyped_storage().data_ptr()
+    for name, operand in operands:
+        if grouped_storage == operand.untyped_storage().data_ptr():
+            raise ValueError(f"grouped_out must not alias {name}")
+
+
+def _pack(
+    kv: torch.Tensor,
+    slots: torch.Tensor,
+    cache: torch.Tensor,
+    *,
+    global_cache: bool,
+    page_size: int | None,
+    page_stride_bytes: int | None,
+    row_stride_bytes: int | None,
+) -> None:
+    if kv.dtype != torch.bfloat16 or kv.ndim != 2 or kv.shape[1] != 512:
+        raise ValueError("kv must be bfloat16 [T, 512]")
+    if not kv.is_cuda or not kv.is_contiguous():
+        raise ValueError("kv must be contiguous CUDA storage")
+    if not cache.is_cuda or cache.device != kv.device:
+        raise ValueError("cache must be a CUDA tensor on kv.device")
+    if slots.ndim != 1 or slots.shape[0] > kv.shape[0]:
+        raise ValueError("slots must be [T] and no longer than kv")
+    if (
+        not slots.is_cuda
+        or slots.device != kv.device
+        or slots.dtype not in (torch.int32, torch.int64)
+        or not slots.is_contiguous()
+    ):
+        raise ValueError("slots must be contiguous CUDA int32/int64 on kv.device")
+    expected = (64, 128) if global_cache else (32,)
+    payload = (
+        DEEPSEEK_V41_GLOBAL_ROW_BYTES if global_cache else DEEPSEEK_V41_SWA_ROW_BYTES
+    )
+    layout = _paged_layout(
+        cache,
+        payload_bytes=payload,
+        expected_page_sizes=expected,
+        page_size=page_size,
+        page_stride_bytes=page_stride_bytes,
+        row_stride_bytes=row_stride_bytes,
+        name="global_cache" if global_cache else "swa_cache",
+    )
+    op = _cache_ops()[1 if global_cache else 0]
+    op(
+        kv,
+        slots,
+        layout.storage,
+        layout.page_size,
+        layout.page_stride,
+        layout.row_stride,
+    )
+
+
+def deepseek_v41_pack_swa_cache(
+    kv: torch.Tensor,
+    slots: torch.Tensor,
+    cache: torch.Tensor,
+    *,
+    page_size: int | None = None,
+    page_stride_bytes: int | None = None,
+    row_stride_bytes: int | None = None,
+) -> None:
+    """Quantize post-RoPE BF16 K to the addressed 528B SWA cache rows."""
+    _pack(
+        kv,
+        slots,
+        cache,
+        global_cache=False,
+        page_size=page_size,
+        page_stride_bytes=page_stride_bytes,
+        row_stride_bytes=row_stride_bytes,
+    )
+
+
+def deepseek_v41_pack_global_cache(
+    kv: torch.Tensor,
+    slots: torch.Tensor,
+    cache: torch.Tensor,
+    *,
+    page_size: int | None = None,
+    page_stride_bytes: int | None = None,
+    row_stride_bytes: int | None = None,
+) -> None:
+    """Quantize post-RoPE BF16 K to the addressed 288B global cache rows."""
+    _pack(
+        kv,
+        slots,
+        cache,
+        global_cache=True,
+        page_size=page_size,
+        page_stride_bytes=page_stride_bytes,
+        row_stride_bytes=row_stride_bytes,
+    )
+
+
+def _deepseek_v41_mixed_sparse_attention_impl(
+    q: torch.Tensor,
+    swa_cache: torch.Tensor,
+    global_cache: torch.Tensor | None,
+    swa_slots: torch.Tensor,
+    global_slots: torch.Tensor | None,
+    sm_scale: float,
+    sinks: torch.Tensor | None = None,
+    *,
+    swa_page_size: int | None = None,
+    swa_page_stride_bytes: int | None = None,
+    swa_row_stride_bytes: int | None = None,
+    global_page_size: int | None = None,
+    global_page_stride_bytes: int | None = None,
+    global_row_stride_bytes: int | None = None,
+    out: torch.Tensor | None = None,
+    workspace: torch.Tensor | None = None,
+    inverse_rope_output: _InverseRopeOutput | None = None,
+) -> torch.Tensor:
+    """Run native BF16-Q attention without expanding either packed cache.
+
+    ``swa_slots`` and ``global_slots`` contain physical token slots. ``-1`` and
+    addresses outside the backing storage are masked. The page/row stride
+    arguments preserve allocator padding between pages.
+    """
+    if q.dtype != torch.bfloat16 or q.ndim != 3 or q.shape[-1] != 512:
+        raise ValueError("q must be bfloat16 [T, H, 512]")
+    if (
+        not q.is_cuda
+        or not q.is_contiguous()
+        or q.shape[0] == 0
+        or q.shape[1] not in (8, 16, 32)
+    ):
+        raise ValueError("q must be contiguous CUDA storage with H in {8,16,32}")
+    compute_capability = torch.cuda.get_device_capability(q.device)
+    if compute_capability not in ((8, 9), (12, 0)):
+        raise ValueError("DeepSeek-V4.1 mixed sparse attention requires SM89 or SM120")
+    if inverse_rope_output is not None:
+        _validate_inverse_rope_layout(inverse_rope_output, q)
+    if not swa_cache.is_cuda or swa_cache.device != q.device:
+        raise ValueError("swa_cache must be a CUDA tensor on q.device")
+    _check_slots(swa_slots, q, "swa_slots")
+    swa = _paged_layout(
+        swa_cache,
+        payload_bytes=DEEPSEEK_V41_SWA_ROW_BYTES,
+        expected_page_sizes=(DEEPSEEK_V41_SWA_PAGE_SIZE,),
+        page_size=swa_page_size,
+        page_stride_bytes=swa_page_stride_bytes,
+        row_stride_bytes=swa_row_stride_bytes,
+        name="swa_cache",
+    )
+    if global_slots is None:
+        if global_cache is not None:
+            raise ValueError("global_cache and global_slots must be supplied together")
+        has_global = False
+        glob = swa
+        global_slots = swa_slots[:, :0]
+    else:
+        _check_slots(global_slots, q, "global_slots")
+        has_global = global_slots.shape[1] > 0
+        if has_global and global_cache is None:
+            raise ValueError("global_cache and global_slots must be supplied together")
+    if has_global:
+        assert global_cache is not None
+        if not global_cache.is_cuda or global_cache.device != q.device:
+            raise ValueError("global_cache must be a CUDA tensor on q.device")
+        glob = _paged_layout(
+            global_cache,
+            payload_bytes=DEEPSEEK_V41_GLOBAL_ROW_BYTES,
+            expected_page_sizes=(64, 128),
+            page_size=global_page_size,
+            page_stride_bytes=global_page_stride_bytes,
+            row_stride_bytes=global_row_stride_bytes,
+            name="global_cache",
+        )
+    elif global_slots.shape[1] == 0:
+        if global_cache is not None and (
+            not global_cache.is_cuda or global_cache.device != q.device
+        ):
+            raise ValueError("global_cache must be a CUDA tensor on q.device")
+        glob = swa
+
+    if sinks is None:
+        sinks = torch.full(
+            (q.shape[1],), -float("inf"), dtype=torch.float32, device=q.device
+        )
+    if (
+        sinks.dtype != torch.float32
+        or sinks.shape != (q.shape[1],)
+        or not sinks.is_cuda
+        or sinks.device != q.device
+        or not sinks.is_contiguous()
+    ):
+        raise ValueError("sinks must be contiguous CUDA float32 [H] on q.device")
+    if out is None:
+        if inverse_rope_output is None:
+            out = torch.empty_like(q)
+        else:
+            out = inverse_rope_output.grouped_out.view(-1)[: q.numel()].view_as(q)
+    if (
+        out.dtype != q.dtype
+        or out.shape != q.shape
+        or not out.is_cuda
+        or out.device != q.device
+        or not out.is_contiguous()
+    ):
+        raise ValueError(
+            "out must be contiguous CUDA bfloat16 on q.device with q.shape"
+        )
+    global_topk = int(global_slots.shape[1]) if has_global else 0
+    num_splits = _attention_num_splits(
+        int(q.shape[0]),
+        int(q.shape[1]),
+        int(swa_slots.shape[1]),
+        global_topk,
+        compute_capability,
+    )
+    unified_tiles = _attention_uses_unified_tiles(
+        int(q.shape[0]),
+        int(q.shape[1]),
+        int(swa_slots.shape[1]),
+        global_topk,
+        compute_capability,
+    )
+    workspace_bytes = deepseek_v41_mixed_sparse_workspace_size(
+        int(q.shape[0]),
+        int(q.shape[1]),
+        int(swa_slots.shape[1]),
+        global_topk,
+    )
+    if workspace is None:
+        workspace = torch.empty(workspace_bytes, dtype=torch.uint8, device=q.device)
+    if (
+        workspace.dtype != torch.uint8
+        or not workspace.is_cuda
+        or workspace.device != q.device
+        or not workspace.is_contiguous()
+        or workspace.storage_offset() % 4 != 0
+        or workspace.numel() < workspace_bytes
+    ):
+        raise ValueError(
+            f"workspace must be aligned contiguous CUDA uint8 with at least "
+            f"{workspace_bytes} bytes on q.device"
+        )
+
+    lse_elements = int(q.shape[0]) * num_splits * int(q.shape[1])
+    if num_splits == 1:
+        partial_out = out.unsqueeze(1)
+        partial_lse = (
+            workspace[: lse_elements * 4]
+            .view(torch.float32)
+            .view(q.shape[0], 1, q.shape[1])
+        )
+    else:
+        partial_elements = int(q.shape[0]) * num_splits * int(q.shape[1]) * _D_HEAD
+        partial_bytes = partial_elements * 2
+        partial_out = (
+            workspace[:partial_bytes]
+            .view(torch.bfloat16)
+            .view(q.shape[0], num_splits, q.shape[1], _D_HEAD)
+        )
+        partial_lse = (
+            workspace[partial_bytes : partial_bytes + lse_elements * 4]
+            .view(torch.float32)
+            .view(q.shape[0], num_splits, q.shape[1])
+        )
+
+    attention_args = (
+        q,
+        swa.storage,
+        glob.storage,
+        swa_slots,
+        global_slots,
+        sinks,
+        partial_out,
+        partial_lse,
+        out,
+        float(sm_scale),
+        num_splits,
+        has_global,
+        unified_tiles,
+        swa.page_size,
+        swa.page_stride,
+        swa.row_stride,
+        glob.page_size,
+        glob.page_stride,
+        glob.row_stride,
+    )
+    with torch.cuda.device(q.device):
+        if inverse_rope_output is None:
+            _attention_op()(*attention_args)
+        else:
+            _check_no_storage_alias(
+                inverse_rope_output.grouped_out,
+                (
+                    ("q", q),
+                    ("swa_cache", swa.storage),
+                    ("global_cache", glob.storage),
+                    ("swa_slots", swa_slots),
+                    ("global_slots", global_slots),
+                    ("sinks", sinks),
+                    ("positions", inverse_rope_output.positions),
+                    ("cos_sin", inverse_rope_output.cos_sin),
+                    ("workspace", workspace),
+                ),
+            )
+            _attention_with_inv_rope_op()(
+                *attention_args,
+                inverse_rope_output.positions,
+                inverse_rope_output.cos_sin,
+                inverse_rope_output.grouped_out,
+                inverse_rope_output.token_offset,
+            )
+    return out
+
+
+@flashinfer_api(trace=deepseek_v41_mixed_sparse_trace)
+def deepseek_v41_mixed_sparse_attention(
+    q: torch.Tensor,
+    swa_cache: torch.Tensor,
+    global_cache: torch.Tensor | None,
+    swa_slots: torch.Tensor,
+    global_slots: torch.Tensor | None,
+    sm_scale: float,
+    sinks: torch.Tensor | None = None,
+    *,
+    swa_page_size: int | None = None,
+    swa_page_stride_bytes: int | None = None,
+    swa_row_stride_bytes: int | None = None,
+    global_page_size: int | None = None,
+    global_page_stride_bytes: int | None = None,
+    global_row_stride_bytes: int | None = None,
+    out: torch.Tensor | None = None,
+    workspace: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Run native BF16-Q attention without expanding either packed cache.
+
+    ``swa_slots`` and ``global_slots`` contain physical token slots. ``-1`` and
+    addresses outside the backing storage are masked. The page/row stride
+    arguments preserve allocator padding between pages.
+    """
+    return _deepseek_v41_mixed_sparse_attention_impl(
+        q,
+        swa_cache,
+        global_cache,
+        swa_slots,
+        global_slots,
+        sm_scale,
+        sinks,
+        swa_page_size=swa_page_size,
+        swa_page_stride_bytes=swa_page_stride_bytes,
+        swa_row_stride_bytes=swa_row_stride_bytes,
+        global_page_size=global_page_size,
+        global_page_stride_bytes=global_page_stride_bytes,
+        global_row_stride_bytes=global_row_stride_bytes,
+        out=out,
+        workspace=workspace,
+    )
+
+
+def _deepseek_v41_mixed_sparse_attention_with_inv_rope(
+    q: torch.Tensor,
+    swa_cache: torch.Tensor,
+    global_cache: torch.Tensor | None,
+    swa_slots: torch.Tensor,
+    global_slots: torch.Tensor | None,
+    sm_scale: float,
+    sinks: torch.Tensor | None = None,
+    *,
+    positions: torch.Tensor,
+    cos_sin: torch.Tensor,
+    grouped_out: torch.Tensor,
+    token_offset: int,
+    swa_page_size: int | None = None,
+    swa_page_stride_bytes: int | None = None,
+    swa_row_stride_bytes: int | None = None,
+    global_page_size: int | None = None,
+    global_page_stride_bytes: int | None = None,
+    global_row_stride_bytes: int | None = None,
+    out: torch.Tensor | None = None,
+    workspace: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Run attention and write inverse-RoPE output in grouped layout."""
+    inverse_rope_output = _InverseRopeOutput(
+        positions=positions,
+        cos_sin=cos_sin,
+        grouped_out=grouped_out,
+        token_offset=token_offset,
+    )
+    _deepseek_v41_mixed_sparse_attention_impl(
+        q,
+        swa_cache,
+        global_cache,
+        swa_slots,
+        global_slots,
+        sm_scale,
+        sinks,
+        swa_page_size=swa_page_size,
+        swa_page_stride_bytes=swa_page_stride_bytes,
+        swa_row_stride_bytes=swa_row_stride_bytes,
+        global_page_size=global_page_size,
+        global_page_stride_bytes=global_page_stride_bytes,
+        global_row_stride_bytes=global_row_stride_bytes,
+        out=out,
+        workspace=workspace,
+        inverse_rope_output=inverse_rope_output,
+    )
+    token_end = token_offset + q.shape[0]
+    return grouped_out[:, token_offset:token_end].transpose(0, 1)
