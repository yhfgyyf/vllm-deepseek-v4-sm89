+
+"""Triton kernels for native DeepSeek-V4.1 mixed sparse attention."""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+from triton.backends.compiler import GPUTarget
+from triton.compiler import ASTSource
+
+HEAD_DIM = 512
+HEAD_TILE = 16
+BLOCK_KV = 32
+SWA_PAYLOAD_BYTES = 528
+GLOBAL_PAYLOAD_BYTES = 288
+LOG2E = 1.4426950408889634
+
+_TL_HEAD_DIM = tl.constexpr(HEAD_DIM)
+_TL_HEAD_TILE = tl.constexpr(HEAD_TILE)
+_TL_SWA_PAYLOAD_BYTES = tl.constexpr(SWA_PAYLOAD_BYTES)
+_TL_GLOBAL_PAYLOAD_BYTES = tl.constexpr(GLOBAL_PAYLOAD_BYTES)
+_TL_LOG2E = tl.constexpr(LOG2E)
+
+
+@triton.jit
+def _decode_e2m1_bits(code):
+    code = code.to(tl.uint32)
+    magnitude = code & 0x7
+    normalized = (((magnitude >> 1) + 126) << 23) | ((magnitude & 1) << 22)
+    magnitude_bits = tl.where(
+        magnitude == 0,
+        0,
+        tl.where(magnitude == 1, 0x3F000000, normalized),
+    )
+    bits = magnitude_bits | ((code & 0x8) << 28)
+    return bits.to(tl.float32, bitcast=True)
+
+
+@triton.jit
+def _load_swa_tile(
+    cache,
+    slots,
+    slot_mask,
+    cache_nbytes,
+    page_stride,
+    row_stride,
+    PAGE_SIZE: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+):
+    slot_limit = (cache_nbytes - _TL_SWA_PAYLOAD_BYTES) // row_stride + 1
+    slot_mask = slot_mask & (slots >= 0) & (slots < slot_limit)
+    safe_slots = tl.where(slot_mask, slots, 0)
+    row_offsets = (safe_slots // PAGE_SIZE) * page_stride + (
+        safe_slots % PAGE_SIZE
+    ) * row_stride
+    valid = slot_mask & (row_offsets + _TL_SWA_PAYLOAD_BYTES <= cache_nbytes)
+
+    dims = tl.arange(0, _TL_HEAD_DIM)
+    raw = tl.load(
+        cache + row_offsets[:, None] + dims[None, :],
+        mask=valid[:, None],
+        other=0,
+    )
+    values = raw.to(tl.float8e4nv, bitcast=True).to(tl.float32)
+    groups = tl.arange(0, _TL_HEAD_DIM // 32)
+    scale_raw = tl.load(
+        cache + row_offsets[:, None] + _TL_HEAD_DIM + groups[None, :],
+        mask=valid[:, None],
+        other=0,
+    )
+    scales = (scale_raw.to(tl.uint32) << 23).to(tl.float32, bitcast=True)
+    values = tl.reshape(values, (BLOCK_N, _TL_HEAD_DIM // 32, 32))
+    values *= scales[:, :, None]
+    return tl.reshape(values, (BLOCK_N, _TL_HEAD_DIM)).to(tl.bfloat16), valid
+
+
+@triton.jit
+def _load_global_tile(
+    cache,
+    slots,
+    slot_mask,
+    cache_nbytes,
+    page_stride,
+    row_stride,
+    PAGE_SIZE: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+):
+    slot_limit = (cache_nbytes - _TL_GLOBAL_PAYLOAD_BYTES) // row_stride + 1
+    slot_mask = slot_mask & (slots >= 0) & (slots < slot_limit)
+    safe_slots = tl.where(slot_mask, slots, 0)
+    row_offsets = (safe_slots // PAGE_SIZE) * page_stride + (
+        safe_slots % PAGE_SIZE
+    ) * row_stride
+    valid = slot_mask & (row_offsets + _TL_GLOBAL_PAYLOAD_BYTES <= cache_nbytes)
+
+    packed_dims = tl.arange(0, _TL_HEAD_DIM // 2)
+    packed = tl.load(
+        cache + row_offsets[:, None] + packed_dims[None, :],
+        mask=valid[:, None],
+        other=0,
+    ).to(tl.int32)
+    values = tl.interleave(
+        _decode_e2m1_bits(packed & 0xF),
+        _decode_e2m1_bits(packed >> 4),
+    )
+    groups = tl.arange(0, _TL_HEAD_DIM // 16)
+    scale_raw = tl.load(
+        cache + row_offsets[:, None] + _TL_HEAD_DIM // 2 + groups[None, :],
+        mask=valid[:, None],
+        other=0,
+    )
+    scales = scale_raw.to(tl.float8e4nv, bitcast=True).to(tl.float32)
+    values = tl.reshape(values, (BLOCK_N, _TL_HEAD_DIM // 16, 16))
+    values *= scales[:, :, None]
+    return tl.reshape(values, (BLOCK_N, _TL_HEAD_DIM)).to(tl.bfloat16), valid
+
+
+@triton.jit
+def _online_step(q, kv, valid, head_mask, m_i, l_i, acc, sm_scale):
+    scores = tl.dot(q, tl.trans(kv), out_dtype=tl.float32) * sm_scale
+    score_mask = head_mask[:, None] & valid[None, :]
+    scores = tl.where(score_mask, scores, -float("inf"))
+    tile_has_values = tl.sum(valid.to(tl.int32), axis=0) > 0
+    tile_max = tl.max(scores, axis=1)
+    update_mask = head_mask & tile_has_values
+    m_next = tl.where(update_mask, tl.maximum(m_i, tile_max), m_i)
+    alpha_delta = tl.where(update_mask, m_i - m_next, 0.0)
+    alpha = tl.exp2(alpha_delta * _TL_LOG2E)
+    score_delta = tl.where(score_mask, scores - m_next[:, None], 0.0)
+    p = tl.exp2(score_delta * _TL_LOG2E)
+    p = tl.where(score_mask, p, 0.0)
+    acc = acc * alpha[:, None] + tl.dot(p.to(tl.bfloat16), kv, out_dtype=tl.float32)
+    l_i = l_i * alpha + tl.sum(p, axis=1)
+    return m_next, l_i, acc
+
+
+@triton.jit(do_not_specialize=["swa_topk", "global_topk"])
+def deepseek_v41_mixed_sparse_main_kernel(
+    q,
+    swa_cache,
+    global_cache,
+    swa_slots,
+    global_slots,
+    sinks,
+    partial_out,
+    partial_lse,
+    swa_nbytes,
+    global_nbytes,
+    swa_topk,
+    global_topk,
+    sm_scale,
+    q_stride_token,
+    q_stride_head,
+    swa_slots_stride_token,
+    global_slots_stride_token,
+    swa_page_stride,
+    swa_row_stride,
+    global_page_stride,
+    global_row_stride,
+    partial_out_stride_token,
+    partial_out_stride_split,
+    partial_out_stride_head,
+    partial_lse_stride_token,
+    partial_lse_stride_split,
+    partial_lse_stride_head,
+    NUM_HEADS: tl.constexpr,
+    NUM_SPLITS: tl.constexpr,
+    HAS_GLOBAL: tl.constexpr,
+    UNIFIED_TILES: tl.constexpr,
+    SWA_PAGE_SIZE: tl.constexpr,
+    GLOBAL_PAGE_SIZE: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+):
+    token = tl.program_id(0).to(tl.int64)
+    head_block = tl.program_id(1).to(tl.int64)
+    split = tl.program_id(2).to(tl.int64)
+
+    heads = head_block * _TL_HEAD_TILE + tl.arange(0, _TL_HEAD_TILE)
+    dims = tl.arange(0, _TL_HEAD_DIM)
+    head_mask = heads < NUM_HEADS
+    q_tile = tl.load(
+        q + token * q_stride_token + heads[:, None] * q_stride_head + dims[None, :],
+        mask=head_mask[:, None],
+        other=0,
+    )
+
+    m_i = tl.full((_TL_HEAD_TILE,), -float("inf"), tl.float32)
+    l_i = tl.zeros((_TL_HEAD_TILE,), tl.float32)
+    acc = tl.zeros((_TL_HEAD_TILE, _TL_HEAD_DIM), tl.float32)
+    offsets = tl.arange(0, BLOCK_N)
+
+    swa_tiles = tl.cdiv(swa_topk, BLOCK_N)
+    global_tiles = tl.cdiv(global_topk, BLOCK_N)
+    if UNIFIED_TILES:
+        tile = split
+        if tile < swa_tiles:
+            slot_offsets = tile * BLOCK_N + offsets
+            slot_mask = slot_offsets < swa_topk
+            slots = tl.load(
+                swa_slots + token * swa_slots_stride_token + slot_offsets,
+                mask=slot_mask,
+                other=-1,
+            ).to(tl.int64)
+            kv, valid = _load_swa_tile(
+                swa_cache,
+                slots,
+                slot_mask,
+                swa_nbytes,
+                swa_page_stride,
+                swa_row_stride,
+                SWA_PAGE_SIZE,
+                BLOCK_N,
+            )
+            m_i, l_i, acc = _online_step(
+                q_tile, kv, valid, head_mask, m_i, l_i, acc, sm_scale
+            )
+        elif HAS_GLOBAL and tile < swa_tiles + global_tiles:
+            global_tile = tile - swa_tiles
+            slot_offsets = global_tile * BLOCK_N + offsets
+            slot_mask = slot_offsets < global_topk
+            slots = tl.load(
+                global_slots + token * global_slots_stride_token + slot_offsets,
+                mask=slot_mask,
+                other=-1,
+            ).to(tl.int64)
+            kv, valid = _load_global_tile(
+                global_cache,
+                slots,
+                slot_mask,
+                global_nbytes,
+                global_page_stride,
+                global_row_stride,
+                GLOBAL_PAGE_SIZE,
+                BLOCK_N,
+            )
+            m_i, l_i, acc = _online_step(
+                q_tile, kv, valid, head_mask, m_i, l_i, acc, sm_scale
+            )
+    else:
+        for tile_iter in tl.range(0, tl.cdiv(swa_tiles, NUM_SPLITS), num_stages=2):
+            tile = tile_iter * NUM_SPLITS + split
+            slot_offsets = tile * BLOCK_N + offsets
+            slot_mask = slot_offsets < swa_topk
+            slots = tl.load(
+                swa_slots + token * swa_slots_stride_token + slot_offsets,
+                mask=slot_mask,
+                other=-1,
+            ).to(tl.int64)
+            kv, valid = _load_swa_tile(
+                swa_cache,
+                slots,
+                slot_mask,
+                swa_nbytes,
+                swa_page_stride,
+                swa_row_stride,
+                SWA_PAGE_SIZE,
+                BLOCK_N,
+            )
+            m_i, l_i, acc = _online_step(
+                q_tile, kv, valid, head_mask, m_i, l_i, acc, sm_scale
+            )
+
+        if HAS_GLOBAL:
+            for tile_iter in tl.range(
+                0, tl.cdiv(global_tiles, NUM_SPLITS), num_stages=2
+            ):
+                tile = tile_iter * NUM_SPLITS + split
+                slot_offsets = tile * BLOCK_N + offsets
+                slot_mask = slot_offsets < global_topk
+                slots = tl.load(
+                    global_slots + token * global_slots_stride_token + slot_offsets,
+                    mask=slot_mask,
+                    other=-1,
+                ).to(tl.int64)
+                kv, valid = _load_global_tile(
+                    global_cache,
+                    slots,
+                    slot_mask,
+                    global_nbytes,
+                    global_page_stride,
+                    global_row_stride,
+                    GLOBAL_PAGE_SIZE,
+                    BLOCK_N,
+                )
+                m_i, l_i, acc = _online_step(
+                    q_tile, kv, valid, head_mask, m_i, l_i, acc, sm_scale
+                )
+
+    if split == 0:
+        sink = tl.load(sinks + heads, mask=head_mask, other=-float("inf"))
+        has_sink = sink > -float("inf")
+        m_next = tl.where(has_sink, tl.maximum(m_i, sink), m_i)
+        alpha_delta = tl.where(has_sink, m_i - m_next, 0.0)
+        sink_delta = tl.where(has_sink, sink - m_next, 0.0)
+        alpha = tl.exp2(alpha_delta * _TL_LOG2E)
+        sink_p = tl.where(has_sink, tl.exp2(sink_delta * _TL_LOG2E), 0.0)
+        acc *= alpha[:, None]
+        l_i = l_i * alpha + sink_p
+        m_i = m_next
+
+    safe_l = tl.where(l_i > 0, l_i, 1.0)
+    normalized = tl.where(l_i[:, None] > 0, acc / safe_l[:, None], 0.0)
+    out_offsets = (
+        token * partial_out_stride_token
+        + split * partial_out_stride_split
+        + heads[:, None] * partial_out_stride_head
+        + dims[None, :]
+    )
+    tl.store(partial_out + out_offsets, normalized, mask=head_mask[:, None])
+    lse = tl.where(l_i > 0, m_i + tl.log(l_i), -float("inf"))
+    lse_offsets = (
+        token * partial_lse_stride_token
+        + split * partial_lse_stride_split
+        + heads * partial_lse_stride_head
+    )
+    tl.store(partial_lse + lse_offsets, lse, mask=head_mask)
+
+
+@triton.jit
+def deepseek_v41_mixed_sparse_merge_kernel(
+    partial_out,
+    partial_lse,
+    out,
+    partial_out_stride_token,
+    partial_out_stride_split,
+    partial_out_stride_head,
+    partial_lse_stride_token,
+    partial_lse_stride_split,
+    partial_lse_stride_head,
+    out_stride_token,
+    out_stride_head,
+    NUM_SPLITS: tl.constexpr,
+    SPLIT_BLOCK: tl.constexpr,
+):
+    token = tl.program_id(0).to(tl.int64)
+    head = tl.program_id(1).to(tl.int64)
+    splits = tl.arange(0, SPLIT_BLOCK)
+    split_mask = splits < NUM_SPLITS
+    dims = tl.arange(0, _TL_HEAD_DIM)
+    lse = tl.load(
+        partial_lse
+        + token * partial_lse_stride_token
+        + splits * partial_lse_stride_split
+        + head * partial_lse_stride_head,
+        mask=split_mask,
+        other=-float("inf"),
+    )
+    max_lse = tl.max(lse, axis=0)
+    has_values = max_lse > -float("inf")
+    safe_max = tl.where(has_values, max_lse, 0.0)
+    weights = tl.where(has_values, tl.exp2((lse - safe_max) * _TL_LOG2E), 0.0)
+    denominator = tl.sum(weights, axis=0)
+    partial = tl.load(
+        partial_out
+        + token * partial_out_stride_token
+        + splits[:, None] * partial_out_stride_split
+        + head * partial_out_stride_head
+        + dims[None, :],
+        mask=split_mask[:, None],
+        other=0.0,
+    ).to(tl.float32)
+    numerator = tl.sum(partial * weights[:, None], axis=0)
+    safe_denominator = tl.where(denominator > 0, denominator, 1.0)
+    result = tl.where(denominator > 0, numerator / safe_denominator, 0.0)
+    tl.store(out + token * out_stride_token + head * out_stride_head + dims, result)
+
+
+def launch_deepseek_v41_mixed_sparse(
+    q: torch.Tensor,
+    swa_storage: torch.Tensor,
+    global_storage: torch.Tensor,
+    swa_slots: torch.Tensor,
+    global_slots: torch.Tensor,
+    sinks: torch.Tensor,
+    partial_out: torch.Tensor,
+    partial_lse: torch.Tensor,
+    out: torch.Tensor,
+    sm_scale: float,
+    *,
+    num_splits: int,
+    has_global: bool,
+    unified_tiles: bool,
+    swa_page_size: int,
+    swa_page_stride: int,
+    swa_row_stride: int,
+    global_page_size: int,
+    global_page_stride: int,
+    global_row_stride: int,
+    _block_n: int = BLOCK_KV,
+    _num_warps: int = 8,
+    _pipeline_stages: int = 2,
+) -> None:
+    grid = (q.shape[0], triton.cdiv(q.shape[1], HEAD_TILE), num_splits)
+    deepseek_v41_mixed_sparse_main_kernel[grid](
+        q,
+        swa_storage,
+        global_storage,
+        swa_slots,
+        global_slots,
+        sinks,
+        partial_out,
+        partial_lse,
+        swa_storage.numel(),
+        global_storage.numel(),
+        swa_slots.shape[1],
+        global_slots.shape[1],
+        sm_scale,
+        q.stride(0),
+        q.stride(1),
+        swa_slots.stride(0),
+        global_slots.stride(0),
+        swa_page_stride,
+        swa_row_stride,
+        global_page_stride,
+        global_row_stride,
+        partial_out.stride(0),
+        partial_out.stride(1),
+        partial_out.stride(2),
+        partial_lse.stride(0),
+        partial_lse.stride(1),
+        partial_lse.stride(2),
+        NUM_HEADS=q.shape[1],
+        NUM_SPLITS=num_splits,
+        HAS_GLOBAL=has_global,
+        UNIFIED_TILES=unified_tiles,
+        SWA_PAGE_SIZE=swa_page_size,
+        GLOBAL_PAGE_SIZE=global_page_size,
+        BLOCK_N=_block_n,
+        num_warps=_num_warps,
+        num_stages=_pipeline_stages,
+    )
+    if num_splits > 1:
+        deepseek_v41_mixed_sparse_merge_kernel[(q.shape[0], q.shape[1])](
+            partial_out,
+            partial_lse,
+            out,
+            partial_out.stride(0),
+            partial_out.stride(1),
+            partial_out.stride(2),
+            partial_lse.stride(0),
+            partial_lse.stride(1),
+            partial_lse.stride(2),
+            out.stride(0),
+            out.stride(1),
+            NUM_SPLITS=num_splits,
+            SPLIT_BLOCK=triton.next_power_of_2(num_splits),
+            num_warps=4,
+        )
+
+
+def _main_ast(
+    num_heads: int,
+    num_splits: int,
+    has_global: bool,
+    global_page_size: int,
+    unified_tiles: bool = False,
+    block_n: int = BLOCK_KV,
+) -> ASTSource:
+    pointer_types = {
+        "q": "*bf16",
+        "swa_cache": "*u8",
+        "global_cache": "*u8",
+        "swa_slots": "*i32",
+        "global_slots": "*i64",
+        "sinks": "*fp32",
+        "partial_out": "*bf16",
+        "partial_lse": "*fp32",
+    }
+    constexprs = {
+        "NUM_HEADS": num_heads,
+        "NUM_SPLITS": num_splits,
+        "HAS_GLOBAL": has_global,
+        "UNIFIED_TILES": unified_tiles,
+        "SWA_PAGE_SIZE": 32,
+        "GLOBAL_PAGE_SIZE": global_page_size,
+        "BLOCK_N": block_n,
+    }
+    signature = {}
+    for name in deepseek_v41_mixed_sparse_main_kernel.arg_names:
+        if name in constexprs:
+            continue
+        if name in pointer_types:
+            signature[name] = pointer_types[name]
+        elif name in ("swa_topk", "global_topk"):
+            signature[name] = "i32"
+        elif name == "sm_scale":
+            signature[name] = "fp32"
+        else:
+            signature[name] = "i64"
+    return ASTSource(deepseek_v41_mixed_sparse_main_kernel, signature, constexprs)
+
+
+def _merge_ast(num_splits: int) -> ASTSource:
+    pointer_types = {
+        "partial_out": "*bf16",
+        "partial_lse": "*fp32",
+        "out": "*bf16",
+    }
+    constexprs = {
+        "NUM_SPLITS": num_splits,
+        "SPLIT_BLOCK": triton.next_power_of_2(num_splits),
+    }
+    signature = {
+        name: pointer_types.get(name, "i64")
+        for name in deepseek_v41_mixed_sparse_merge_kernel.arg_names
+        if name not in constexprs
+    }
+    return ASTSource(deepseek_v41_mixed_sparse_merge_kernel, signature, constexprs)
+
