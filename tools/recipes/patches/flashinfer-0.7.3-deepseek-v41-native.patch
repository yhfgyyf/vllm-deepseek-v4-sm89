+        graph.replay()
+        torch.cuda.synchronize()
+
+        swa_decoded = _decode_swa(
+            _gather(
+                swa_cache,
+                swa_slots[:1],
+                32,
+                swa_page_stride,
+                544,
+                528,
+            ).flatten(0, 1)
+        )
+        global_decoded = _decode_global(
+            _gather(
+                global_cache,
+                global_slots[:1],
+                128,
+                global_page_stride,
+                304,
+                288,
+            ).flatten(0, 1)
+        )
+        kv = torch.cat((swa_decoded, global_decoded)).to(torch.bfloat16)
+        logits = q[0].float() @ kv.float().T * (512**-0.5)
+        logits = torch.cat((logits, sinks[:, None]), dim=1)
+        probs = logits.softmax(dim=1)[:, :-1].to(torch.bfloat16)
+        expected = (probs.float() @ kv.float()).to(torch.bfloat16)
+        torch.testing.assert_close(out[0], expected, rtol=3e-2, atol=3e-2)
+        assert torch.isfinite(out[1:]).all()
+        assert torch.count_nonzero(out[1:]).item() == 0
+        assert torch.all(swa_backing[:prefix] == 0xA5)
+        assert torch.all(global_backing[:prefix] == 0xA5)
+        assert torch.all(swa_cache[..., 528:] == 0xA5)
+    assert torch.all(global_cache[..., 288:] == 0xA5)
