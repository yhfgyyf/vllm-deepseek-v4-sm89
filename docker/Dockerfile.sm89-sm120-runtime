FROM nvidia/cuda:13.0.3-base-ubuntu24.04 AS runtime-base

ARG UBUNTU_MIRROR=https://mirrors.aliyun.com/ubuntu

ENV DEBIAN_FRONTEND=noninteractive

RUN sed -Ei \
        "s#https?://(archive|security).ubuntu.com/ubuntu/?#${UBUNTU_MIRROR}/#g" \
        /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        libibverbs-dev \
        libnuma-dev \
        ninja-build \
        numactl \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

FROM runtime-base AS python-deps

ARG UV_VERSION=0.10.7
ARG PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
ARG VLLM_WHEEL_URL="https://github.com/yhfgyyf/vllm-deepseek-v4-sm89/releases/download/v0.28.1rc0-vision-sm89-sm120-cu130/vllm-0.28.1rc0.dev293%2Bgcb7a435391.glm53.dsv4.vision7.sm89sm120.cu130-cp312-cp312-linux_x86_64.whl#sha256=7a445495453b4d758c934cf4f9800edfbfb5eb081abe087f9726e8df2c70df76"

RUN python3.12 -m venv /tmp/uv-bootstrap \
    && /tmp/uv-bootstrap/bin/pip install \
        --no-cache-dir \
        --index-url "${PYPI_INDEX_URL}" \
        "uv==${UV_VERSION}" \
    && /tmp/uv-bootstrap/bin/uv venv \
        --python /usr/bin/python3.12 \
        --seed \
        /opt/venv \
    && UV_DEFAULT_INDEX="${PYPI_INDEX_URL}" \
        UV_INDEX_STRATEGY=unsafe-best-match \
        UV_NO_CACHE=1 \
        /tmp/uv-bootstrap/bin/uv pip install \
        --python /opt/venv/bin/python \
        --torch-backend=cu130 \
        "${VLLM_WHEEL_URL}" \
    && /tmp/uv-bootstrap/bin/uv pip uninstall \
        --python /opt/venv/bin/python \
        torchaudio torchcodec \
    && find /opt/venv/lib/python3.12/site-packages/vllm \
        -type f -name '*.so' -exec strip --strip-debug {} + \
    && /opt/venv/bin/python -c \
        'import importlib.metadata as m; print(m.version("vllm"), m.version("flashinfer-python"), m.version("torch"))' \
    && rm -rf /tmp/uv-bootstrap /root/.cache

FROM runtime-base AS cuda-jit-runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        cuda-cuobjdump-13-0 \
        cuda-nvcc-13-0 \
        cuda-nvrtc-13-0 \
    && rm -rf /var/lib/apt/lists/*

FROM cuda-jit-runtime

ARG SOURCE_COMMIT=cb7a43539108e9e0c975de02cee35355a413fae3
ARG IMAGE_VERSION=0.28.1rc0-vision7-sm89-sm120-cu130

COPY --from=python-deps /opt/venv /opt/venv

ENV CUDA_HOME=/usr/local/cuda \
    FLASHINFER_DISABLE_VERSION_CHECK=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64:/opt/venv/lib/python3.12/site-packages/nvidia/cu13/lib \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    NVIDIA_VISIBLE_DEVICES=all \
    PATH=/opt/venv/bin:/usr/local/cuda/bin:/opt/venv/lib/python3.12/site-packages/nvidia/cu13/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TORCH_CUDA_ARCH_LIST="8.9 12.0" \
    VLLM_USAGE_SOURCE=production-docker-image

LABEL org.opencontainers.image.description="Run DeepSeek-V4-Flash, DeepSeek-V4-Flash-Vision-Exp, and GLM-5.3-Flash on SM89 and SM120 with vLLM" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.source="https://github.com/yhfgyyf/vllm-deepseek-v4-sm89" \
      org.opencontainers.image.version="${IMAGE_VERSION}"

WORKDIR /workspace
EXPOSE 8000
ENTRYPOINT ["vllm", "serve"]
