+def test_v41_pack_boundaries_and_page_padding(page_size):
+    device = torch.device("cuda")
+    values = torch.zeros(5, 512, dtype=torch.bfloat16, device=device)
+    boundaries = torch.tensor(
+        [0.25, 0.75, 1.25, 1.75, 2.5, 3.5, 5.0, -0.25],
+        dtype=torch.bfloat16,
+        device=device,
+    )
+    values[0, :8] = boundaries
+    values[1, 480:] = torch.linspace(-448, 448, 32, device=device)
+    values[2].fill_(2**-20)
+    values[3, :2] = torch.tensor(
+        [-0.29296875, 1.40625], dtype=torch.bfloat16, device=device
+    )
+    values[4, :2] = torch.tensor(
+        [-0.5859375, 2.8125], dtype=torch.bfloat16, device=device
+    )
+
+    swa_backing = torch.full(
+        (2 * (32 * 544 + 64),), 0xA5, dtype=torch.uint8, device=device
+    )
+    swa = swa_backing.as_strided((2, 32, 544), (32 * 544 + 64, 544, 1))
+    swa_slots = torch.tensor([0, 31, 32, 33, 63], dtype=torch.int32, device=device)
+    deepseek_v41_pack_swa_cache(values, swa_slots, swa)
+    swa_rows = _gather(swa, swa_slots[None], 32, swa.stride(0), 544, 528)[0]
+    swa_dequant = _decode_swa(swa_rows)
+    assert torch.isfinite(swa_dequant).all()
+    swa_amax = values.float().unflatten(-1, (16, 32)).abs().amax(dim=-1)
+    expected_swa_scales = torch.pow(
+        2.0,
+        torch.ceil(torch.log2(torch.clamp_min(swa_amax, 1.0e-4) / 448.0)),
+    ).to(torch.float8_e8m0fnu)
+    assert torch.equal(swa_rows[:, 512:528], expected_swa_scales.view(torch.uint8))
+
+    global_backing = torch.full(
+        (2 * (page_size * 304 + 128),), 0xA5, dtype=torch.uint8, device=device
+    )
+    global_cache = global_backing.as_strided(
+        (2, page_size, 304), (page_size * 304 + 128, 304, 1)
+    )
+    global_slots = torch.tensor(
+        [0, page_size - 1, page_size, 1, 2], dtype=torch.int64, device=device
+    )
+    deepseek_v41_pack_global_cache(values, global_slots, global_cache)
+    global_rows = _gather(
+        global_cache,
+        global_slots[None],
+        page_size,
+        global_cache.stride(0),
+        304,
+        288,
+    )[0]
+    global_dequant = _decode_global(global_rows)
+    assert torch.isfinite(global_dequant).all()
+    global_amax = values.float().unflatten(-1, (32, 16)).abs().amax(dim=-1)
+    expected_global_scales = (torch.clamp_min(global_amax, 6 * 2**-9) / 6).to(
+        torch.float8_e4m3fn
+    )
+    assert torch.equal(
+        global_rows[:, 256:288], expected_global_scales.view(torch.uint8)
+    )
+    assert global_rows[3, 0].item() == 0x7A
+    assert global_rows[4, 0].item() == 0x7A
+    assert torch.all(swa_backing[32 * 544 : 32 * 544 + 64] == 0xA5)
+    assert torch.all(global_backing[page_size * 304 : page_size * 304 + 128] == 0xA5)
+
