+"""Native mixed sparse MLA for DeepSeek-V4.1 Flash."""
+
+from __future__ import annotations
+
+import functools
+from dataclasses import dataclass
+
+import torch
+
+from ..api_logging import flashinfer_api
+from ..trace.templates.deepseek_v41 import deepseek_v41_mixed_sparse_trace
+from ..utils import register_custom_op, register_fake_op
+
+DEEPSEEK_V41_SWA_FORMAT = "fp8_e4m3_ue8m0_g32"
+DEEPSEEK_V41_GLOBAL_FORMAT = "fp4_e2m1_e4m3_g16"
+DEEPSEEK_V41_SWA_ROW_BYTES = 528
+DEEPSEEK_V41_GLOBAL_ROW_BYTES = 288
+DEEPSEEK_V41_SWA_PAGE_SIZE = 32
+
+_D_HEAD = 512
+_CANDIDATE_TILE = 32
+_UNIFIED_CANDIDATE_TILE = 16
+_MAX_DECODE_SPLITS = 16
+
+
+@dataclass(frozen=True)
+class _PagedByteLayout:
+    storage: torch.Tensor
+    page_size: int
+    page_stride: int
+    row_stride: int
+
+
+@dataclass(frozen=True)
+class _InverseRopeOutput:
+    positions: torch.Tensor
+    cos_sin: torch.Tensor
+    grouped_out: torch.Tensor
+    token_offset: int
+
+
+def _storage_view(cache: torch.Tensor, span_bytes: int) -> torch.Tensor:
+    storage_bytes = cache.untyped_storage().nbytes()
+    offset_bytes = cache.storage_offset() * cache.element_size()
+    available_bytes = storage_bytes - offset_bytes
+    if span_bytes < 0 or span_bytes > available_bytes:
+        raise ValueError("cache layout exceeds its backing storage")
+    return cache.as_strided((span_bytes,), (1,), cache.storage_offset())
+
+
+def _paged_layout(
+    cache: torch.Tensor,
+    *,
+    payload_bytes: int,
+    expected_page_sizes: tuple[int, ...],
+    page_size: int | None,
+    page_stride_bytes: int | None,
+    row_stride_bytes: int | None,
+    name: str,
+) -> _PagedByteLayout:
+    if cache.dtype != torch.uint8 or not cache.is_cuda:
+        raise ValueError(f"{name} must be a CUDA uint8 tensor")
+    if cache.storage_offset() < 0:
+        raise ValueError(f"{name} has an invalid storage offset")
+    if cache.ndim == 3:
+        if cache.shape[0] == 0 or cache.shape[1] == 0:
+            raise ValueError(f"{name} must contain at least one cache row")
+        inferred_page_size = int(cache.shape[1])
+        inferred_row_stride = int(cache.stride(1))
+        inferred_page_stride = int(cache.stride(0))
+        if cache.stride(2) != 1 or cache.shape[2] < payload_bytes:
+            raise ValueError(
+                f"{name} must have contiguous byte rows at least "
+                f"{payload_bytes} bytes wide"
+            )
+    elif cache.ndim == 2:
+        if cache.shape[0] == 0:
+            raise ValueError(f"{name} must contain at least one cache row")
+        if cache.stride(1) != 1 or cache.shape[1] < payload_bytes:
+            raise ValueError(
+                f"{name} must be [rows, row_bytes>={payload_bytes}] with "
+                "contiguous rows"
+            )
+        inferred_page_size = expected_page_sizes[0] if page_size is None else page_size
+        inferred_row_stride = int(cache.stride(0))
+        inferred_page_stride = inferred_page_size * inferred_row_stride
+    elif cache.ndim == 1:
+        if cache.stride(0) != 1:
+            raise ValueError(f"1-D {name} storage must be contiguous")
+        if page_size is None or page_stride_bytes is None or row_stride_bytes is None:
+            raise ValueError(
+                f"1-D {name} requires page_size, page_stride_bytes, and "
+                "row_stride_bytes"
+            )
+        inferred_page_size = page_size
+        inferred_page_stride = page_stride_bytes
+        inferred_row_stride = row_stride_bytes
+    else:
+        raise ValueError(
+            f"{name} must be 1-D storage, 2-D flat rows, or 3-D paged rows"
+        )
+
+    resolved_page_size = inferred_page_size if page_size is None else page_size
+    resolved_row_stride = (
+        inferred_row_stride if row_stride_bytes is None else row_stride_bytes
+    )
+    resolved_page_stride = (
+        inferred_page_stride if page_stride_bytes is None else page_stride_bytes
+    )
+    if resolved_page_size not in expected_page_sizes:
+        raise ValueError(
+            f"{name} page_size must be one of {expected_page_sizes}, got "
+            f"{resolved_page_size}"
+        )
+    if cache.ndim == 3 and resolved_page_size != cache.shape[1]:
+        raise ValueError(f"{name} page_size does not match cache.shape[1]")
+    if cache.ndim == 3 and (
+        resolved_page_stride != inferred_page_stride
+        or resolved_row_stride != inferred_row_stride
+    ):
+        raise ValueError(f"{name} stride arguments do not match its tensor strides")
+    if cache.ndim == 2 and (
+        resolved_row_stride != inferred_row_stride
+        or resolved_page_stride != resolved_page_size * resolved_row_stride
+    ):
+        raise ValueError(f"2-D {name} must use a compact paged layout")
+    if resolved_row_stride < payload_bytes:
+        raise ValueError(
+            f"{name} row stride is smaller than its {payload_bytes}B payload"
+        )
+    if resolved_page_stride < resolved_page_size * resolved_row_stride:
+        raise ValueError(f"{name} page stride overlaps rows within a page")
+    if cache.ndim == 3:
+        last_slot = int(cache.shape[0]) * resolved_page_size - 1
+    elif cache.ndim == 2:
+        last_slot = int(cache.shape[0]) - 1
+    else:
+        last_slot = -1
+    if last_slot >= 0:
+        logical_span = (
+            (last_slot // resolved_page_size) * resolved_page_stride
+            + (last_slot % resolved_page_size) * resolved_row_stride
+            + payload_bytes
+        )
+    else:
+        logical_span = cache.numel()
+    return _PagedByteLayout(
+        _storage_view(cache, int(logical_span)),
+        int(resolved_page_size),
+        int(resolved_page_stride),
+        int(resolved_row_stride),
+    )
+
+
+def _check_slots(slots: torch.Tensor, q: torch.Tensor, name: str) -> None:
+    if not slots.is_cuda or slots.device != q.device:
+        raise ValueError(f"{name} must be a CUDA tensor on q.device")
+    if slots.dtype not in (torch.int32, torch.int64):
+        raise ValueError(f"{name} must be int32 or int64")
+    if slots.ndim != 2 or slots.shape[0] != q.shape[0]:
+        raise ValueError(f"{name} must have shape [q.shape[0], K]")
+    if not slots.is_contiguous():
+        raise ValueError(f"{name} must be contiguous")
+
+
+def _attention_num_splits(
+    num_tokens: int,
+    num_heads: int,
+    swa_topk: int,
+    global_topk: int,
+    compute_capability: tuple[int, int] | None = None,
+) -> int:
+    if _attention_uses_unified_tiles(
+        num_tokens, num_heads, swa_topk, global_topk, compute_capability
+    ):
+        return (swa_topk + _UNIFIED_CANDIDATE_TILE - 1) // _UNIFIED_CANDIDATE_TILE + (
+            global_topk + _UNIFIED_CANDIDATE_TILE - 1
+        ) // _UNIFIED_CANDIDATE_TILE
+    if compute_capability == (8, 9):
+        if (num_tokens, num_heads, swa_topk, global_topk) == (5, 16, 192, 0):
+            return 8
+        if (
+            num_heads == 32
+            and 5 <= num_tokens <= 8
+            and swa_topk == 128
+            and global_topk == 512
+        ):
+            return 16
+    if num_tokens > 32:
+        return 1
+    swa_tiles = (swa_topk + _CANDIDATE_TILE - 1) // _CANDIDATE_TILE
+    global_tiles = (global_topk + _CANDIDATE_TILE - 1) // _CANDIDATE_TILE
+    candidate_splits = min(_MAX_DECODE_SPLITS, max(1, swa_tiles, global_tiles))
+    head_tiles = (num_heads + 15) // 16
+    occupancy_splits = (128 + num_tokens * head_tiles - 1) // (num_tokens * head_tiles)
+    return min(candidate_splits, max(1, occupancy_splits))
+
+
+def _attention_uses_unified_tiles(
+    num_tokens: int,
+    num_heads: int,
+    swa_topk: int,
+    global_topk: int,
+    compute_capability: tuple[int, int] | None = None,
+) -> bool:
+    # Profiled Ada decode shapes; keep the existing dispatch on other devices.
+    if compute_capability == (8, 9) and swa_topk == 128 and global_topk == 512:
+        if num_heads == 16 and 1 <= num_tokens <= 8:
+            return True
+        if num_heads == 32 and 1 <= num_tokens <= 4:
+            return True
+    total_tiles = (swa_topk + _CANDIDATE_TILE - 1) // _CANDIDATE_TILE + (
+        global_topk + _CANDIDATE_TILE - 1
+    ) // _CANDIDATE_TILE
+    return num_tokens == 1 and num_heads == 8 and global_topk > 0 and total_tiles <= 32
+
+
+def deepseek_v41_mixed_sparse_workspace_size(
+    num_tokens: int,
+    num_heads: int,
+    swa_topk: int,
+    global_topk: int = 0,
+) -> int:
+    """Return workspace bytes sufficient for every supported architecture."""
+    if num_tokens < 0 or swa_topk < 0 or global_topk < 0:
+        raise ValueError("token and candidate counts must be non-negative")
+    if num_heads not in (8, 16, 32):
+        raise ValueError("num_heads must be one of {8,16,32}")
+    if num_tokens == 0:
+        return 0
+    num_splits = max(
+        _attention_num_splits(num_tokens, num_heads, swa_topk, global_topk, arch)
+        for arch in (None, (8, 9))
+    )
+    lse_bytes = num_tokens * num_splits * num_heads * 4
+    if num_splits == 1:
+        return lse_bytes
+    partial_bytes = num_tokens * num_splits * num_heads * _D_HEAD * 2
+    return partial_bytes + lse_bytes
+
+
+def deepseek_v41_mixed_sparse_workspace_size_upper_bound(
+    max_num_tokens: int,
+    num_heads: int,
+    min_swa_topk: int,
+    max_swa_topk: int,
+    global_topk: int = 0,
+) -> int:
+    """Return bytes sufficient for every supported shape in the given range."""
+    if min_swa_topk < 0 or min_swa_topk > max_swa_topk:
+        raise ValueError("SWA candidate bounds must satisfy 0 <= min <= max")
+    if max_num_tokens < 0 or global_topk < 0:
+        raise ValueError("token and candidate counts must be non-negative")
+    if num_heads not in (8, 16, 32):
+        raise ValueError("num_heads must be one of {8,16,32}")
+    if max_num_tokens == 0:
+        return 0
+
+    token_counts = range(1, min(max_num_tokens, 32) + 1)
+    if max_num_tokens > 32:
+        token_counts = (*token_counts, max_num_tokens)
+    min_tiles = (min_swa_topk + _CANDIDATE_TILE - 1) // _CANDIDATE_TILE
+    max_tiles = (max_swa_topk + _CANDIDATE_TILE - 1) // _CANDIDATE_TILE
+    swa_topks = {min_swa_topk, max_swa_topk}
+    # SM89 tuning has exact-width boundaries inside the generic tile ranges.
+    swa_topks.update(
+        width for width in (128, 192) if min_swa_topk <= width <= max_swa_topk
+    )
+    for num_tiles in range(min_tiles, min(max_tiles, 32) + 1):
+        representative = 0 if num_tiles == 0 else (num_tiles - 1) * _CANDIDATE_TILE + 1
+        if min_swa_topk <= representative <= max_swa_topk:
+            swa_topks.add(representative)
+    if num_heads == 8 and global_topk > 0:
+        global_tiles = (global_topk + _CANDIDATE_TILE - 1) // _CANDIDATE_TILE
+        max_unified_swa_topk = max(0, 32 - global_tiles) * _CANDIDATE_TILE
+        unified_end = min(max_swa_topk, max_unified_swa_topk)
+        if unified_end >= min_swa_topk:
+            swa_topks.add(unified_end)
+            first_unified_tile = (
+                min_swa_topk + _UNIFIED_CANDIDATE_TILE - 1
+            ) // _UNIFIED_CANDIDATE_TILE
+            last_unified_tile = (
+                unified_end + _UNIFIED_CANDIDATE_TILE - 1
+            ) // _UNIFIED_CANDIDATE_TILE
+            for num_tiles in range(first_unified_tile, last_unified_tile + 1):
+                representative = max(
+                    min_swa_topk,
+                    (num_tiles - 1) * _UNIFIED_CANDIDATE_TILE + 1,
+                )
+                swa_topks.add(representative)
+    return max(
+        deepseek_v41_mixed_sparse_workspace_size(
+            num_tokens, num_heads, swa_topk, global_topk
+        )
+        for num_tokens in token_counts
+        for swa_topk in swa_topks
+    )
+
+
+@functools.cache
+def _cache_ops():
