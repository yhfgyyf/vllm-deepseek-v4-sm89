+
+import os
+
+from . import env as jit_env
+from .core import JitSpec, gen_jit_spec, current_compilation_context
+
+_SPARSE_MLA_FORCE_SM89_PRIMS_ENV = "FLASHINFER_SPARSE_MLA_FORCE_SM89_PRIMS"
+
+
+def _is_sparse_mla_supported_arch(major: int, minor: object) -> bool:
+    minor_str = str(minor).lower().removesuffix("a").removesuffix("f")
+    return major == 12 or (major == 8 and minor_str == "9")
+
+
+def _sparse_mla_nvcc_flags() -> list[str]:
+    supported_cuda_archs = [
+        (major, minor)
+        for major, minor in current_compilation_context.TARGET_CUDA_ARCHS
+        if _is_sparse_mla_supported_arch(major, minor)
+    ]
+    if len(supported_cuda_archs) == 0:
+        raise RuntimeError(
+            "No supported CUDA architectures found for sparse MLA SM89/SM12x."
+        )
+    return [
+        f"-gencode=arch=compute_{major}{minor},code=sm_{major}{minor}"
+        for major, minor in sorted(
+            supported_cuda_archs, key=lambda arch: (arch[0], str(arch[1]))
+        )
+    ] + current_compilation_context.COMMON_NVCC_FLAGS
+
+
+
+
+def gen_sparse_mla_sm89_compat_module() -> JitSpec:
+    """Sparse-MLA paged attention for SM120.
+
+    Monolithic module: runtime dispatch on model type, head count, top-k,
+    page block size, and optional extra page block size happens inside the
+    orchestrator.
+    """
+    nvcc_flags = _sparse_mla_nvcc_flags()
+    name = "sparse_mla_sm89_compat_glm_nope"
+    if os.environ.get(_SPARSE_MLA_FORCE_SM89_PRIMS_ENV, "0") not in (
+        "",
+        "0",
+        "false",
+        "False",
+    ):
+        name += "_sm89_prims"
+        nvcc_flags.append("-DSPARSE_MLA_FORCE_SM89_PRIMS=1")
+    return gen_jit_spec(
+        name,
+        [
+            jit_env.FLASHINFER_CSRC_DIR / "sparse_mla_sm89_compat.cu",
+            jit_env.FLASHINFER_CSRC_DIR / "sparse_mla_sm89_compat_decode_dsv3_2.cu",
+            jit_env.FLASHINFER_CSRC_DIR / "sparse_mla_sm89_compat_decode_dsv4.cu",
+            jit_env.FLASHINFER_CSRC_DIR / "sparse_mla_sm89_compat_prefill.cu",
+            jit_env.FLASHINFER_CSRC_DIR / "sparse_mla_sm89_compat_cache.cu",
+            jit_env.FLASHINFER_CSRC_DIR / "sparse_mla_sm89_compat_jit_binding.cu",
+        ],
+        extra_cuda_cflags=nvcc_flags,
+    )
