+def _validate_inverse_rope_layout(
+    epilogue: _InverseRopeOutput, q: torch.Tensor
+) -> None:
+    positions = epilogue.positions
+    if (
+        positions.dtype != torch.int64
+        or positions.shape != (q.shape[0],)
+        or not positions.is_cuda
+        or positions.device != q.device
+        or not positions.is_contiguous()
+    ):
+        raise ValueError("positions must be contiguous CUDA int64 [T] on q.device")
+    cos_sin = epilogue.cos_sin
+    if (
+        cos_sin.dtype != torch.float32
+        or cos_sin.ndim != 2
+        or cos_sin.shape[0] == 0
+        or cos_sin.shape[1] != 64
+        or not cos_sin.is_cuda
+        or cos_sin.device != q.device
+        or not cos_sin.is_contiguous()
+    ):
+        raise ValueError("cos_sin must be contiguous CUDA float32 [L, 64] on q.device")
+    grouped_out = epilogue.grouped_out
+    if (
+        grouped_out.dtype != torch.bfloat16
+        or grouped_out.ndim != 3
+        or grouped_out.shape[0] == 0
+        or not grouped_out.is_cuda
+        or grouped_out.device != q.device
+        or not grouped_out.is_contiguous()
+    ):
+        raise ValueError("grouped_out must be contiguous CUDA bfloat16 [G, T, D]")
+    groups = int(grouped_out.shape[0])
+    if q.shape[1] % groups != 0 or q.shape[1] // groups != 8:
+        raise ValueError("fused inverse RoPE requires exactly eight heads per group")
+    if grouped_out.shape[2] != 8 * _D_HEAD:
+        raise ValueError("grouped_out.shape[2] must be 4096")
+    if isinstance(epilogue.token_offset, bool) or not isinstance(
+        epilogue.token_offset, int
+    ):
+        raise ValueError("token_offset must be an int")
+    if (
+        epilogue.token_offset < 0
+        or epilogue.token_offset + q.shape[0] > grouped_out.shape[1]
+    ):
+        raise ValueError("token_offset and T exceed grouped_out token capacity")
+
