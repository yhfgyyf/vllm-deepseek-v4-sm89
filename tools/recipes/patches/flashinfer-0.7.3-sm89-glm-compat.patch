+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: BSD-3-Clause
+
+"""GLM NoPE sparse-MLA cache helpers for SM120."""
+
+from __future__ import annotations
+
+import functools
+
+import torch
+
+from ..jit.sparse_mla_sm89_compat import gen_sparse_mla_sm89_compat_module
+from ..utils import (
+    register_custom_op,
+    register_fake_op,
+    supported_compute_capability,
+)
+
+_D_NOPE = 512
+_BPT_GLM_NOPE = 528
+
+
+def _validate_cpu_workspace_starts(
+    workspace_starts: torch.Tensor,
+    batch_size: int,
+    dst_num_tokens: int,
+) -> None:
+    if workspace_starts.is_cuda:
+        return
+    starts = workspace_starts[: batch_size + 1]
+    if starts.numel() == 0:
+        return
+    if starts[0].item() < 0:
+        raise ValueError("workspace_starts[0] must be non-negative")
+    if torch.any(starts[1:] < starts[:-1]).item():
+        raise ValueError("workspace_starts must be non-decreasing")
+    if starts[-1].item() > dst_num_tokens:
+        raise ValueError("workspace_starts[-1] cannot exceed dst.shape[0]")
+
+
+def _check_glm_nope_cache(kv_cache: torch.Tensor) -> None:
+    if kv_cache.dtype != torch.uint8:
+        raise ValueError(f"kv_cache must be uint8, got {kv_cache.dtype}")
+    if kv_cache.ndim not in (2, 3, 4):
+        raise ValueError(
+            "kv_cache must be [num_blocks, page_bytes], "
+            "[num_blocks, block_size, 528], HND [num_blocks, 1, block_size, "
+            "528], or NHD [num_blocks, block_size, 1, 528]"
+        )
+    if kv_cache.ndim == 2:
+        if kv_cache.shape[1] % _BPT_GLM_NOPE != 0:
+            raise ValueError("2D kv_cache width must be divisible by 528")
+        return
+    if kv_cache.shape[-1] != _BPT_GLM_NOPE:
+        raise ValueError(
+            f"GLM NoPE kv_cache last dim must be 528, got {kv_cache.shape[-1]}"
+        )
+    if kv_cache.ndim == 4 and kv_cache.shape[1] != 1 and kv_cache.shape[2] != 1:
+        raise ValueError("4D kv_cache must have one singleton KV-head axis")
+
+
+@functools.cache
+def get_sparse_mla_sm89_compat_cache_module():
+    module = gen_sparse_mla_sm89_compat_module().build_and_load()
+
+    @register_custom_op(
+        "flashinfer::sparse_mla_sm89_compat_pack_glm_nope_cache",
+        mutates_args=("kv_cache",),
+    )
+    def _pack_glm_nope_cache(
+        kv_c: torch.Tensor,
+        kv_cache: torch.Tensor,
+        slot_mapping: torch.Tensor,
+    ) -> None:
+        module.sparse_mla_sm89_compat_pack_glm_nope_cache(kv_c, slot_mapping, kv_cache)
+
+    @register_fake_op("flashinfer::sparse_mla_sm89_compat_pack_glm_nope_cache")
+    def _fake_pack_glm_nope_cache(*_args, **_kwargs) -> None:
+        return None
+
+    @register_custom_op(
+        "flashinfer::sparse_mla_sm89_compat_gather_glm_nope_cache",
+        mutates_args=("dst",),
+    )
+    def _gather_glm_nope_cache(
+        kv_cache: torch.Tensor,
+        dst: torch.Tensor,
+        block_table: torch.Tensor,
+        workspace_starts: torch.Tensor,
+        batch_size: int,
+        seq_starts: torch.Tensor | None,
+    ) -> None:
+        module.sparse_mla_sm89_compat_gather_glm_nope_cache(
+            kv_cache,
+            dst,
+            block_table,
+            workspace_starts,
+            batch_size,
+            seq_starts,
+        )
+
+    @register_fake_op("flashinfer::sparse_mla_sm89_compat_gather_glm_nope_cache")
+    def _fake_gather_glm_nope_cache(*_args, **_kwargs) -> None:
+        return None
+
+    return _pack_glm_nope_cache, _gather_glm_nope_cache
+
+
+@supported_compute_capability([89, 120, 121])
+def sparse_mla_sm89_compat_pack_glm_nope_cache(
+    kv: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    kv_cache: torch.Tensor,
+) -> None:
+    """Pack bf16 GLM NoPE KV into the 528B sparse-MLA paged cache.
+
+    CUDA slot values outside the cache capacity are skipped instead of raising,
+    avoiding a host synchronization on the common CUDA-tensor path.
+    """
+    if kv.dtype != torch.bfloat16:
+        raise ValueError(f"kv must be bf16, got {kv.dtype}")
+    if slot_mapping.dtype != torch.int64:
+        raise ValueError(f"slot_mapping must be int64, got {slot_mapping.dtype}")
+    if kv.ndim != 2 or kv.shape[1] != _D_NOPE:
+        raise ValueError(f"kv must be [num_tokens, 512], got {tuple(kv.shape)}")
+    if slot_mapping.ndim != 1 or slot_mapping.shape[0] > kv.shape[0]:
+        raise ValueError(
+            "slot_mapping must be 1-D and cannot be longer than kv.shape[0]"
+        )
+    _check_glm_nope_cache(kv_cache)
+    pack, _ = get_sparse_mla_sm89_compat_cache_module()
+    pack(kv, kv_cache, slot_mapping)
+
+
+@supported_compute_capability([89, 120, 121])
+def glm_nope_quantize_and_cache(
+    kv_c: torch.Tensor,
+    kv_cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+) -> None:
+    """Pack bf16 GLM NoPE KV into the 528B sparse-MLA paged cache."""
+    sparse_mla_sm89_compat_pack_glm_nope_cache(kv_c, slot_mapping, kv_cache)
+
+
+@supported_compute_capability([89, 120, 121])
+def glm_nope_gather_and_dequantize(
+    kv_cache: torch.Tensor,
+    dst: torch.Tensor,
+    block_table: torch.Tensor,
+    workspace_starts: torch.Tensor,
+    batch_size: int,
+    seq_starts: torch.Tensor | None = None,
+) -> None:
+    """Gather and dequantize GLM NoPE sparse-MLA cache rows into bf16.
+
+    CUDA physical block ids outside the cache capacity produce zeros instead of
+    raising, avoiding a host synchronization on the common CUDA-tensor path.
+    """
+    if batch_size < 0:
+        raise ValueError("batch_size must be non-negative")
+    _check_glm_nope_cache(kv_cache)
+    if block_table.dtype != torch.int32 or block_table.ndim != 2:
+        raise ValueError("block_table must be int32 [num_seqs, max_blocks]")
+    if batch_size > block_table.shape[0]:
+        raise ValueError("batch_size cannot exceed block_table.shape[0]")
+    if workspace_starts.dtype not in (torch.int32, torch.int64):
+        raise ValueError("workspace_starts must be int32 or int64")
+    if workspace_starts.ndim != 1 or workspace_starts.shape[0] < batch_size + 1:
+        raise ValueError("workspace_starts must be [batch_size + 1]")
+    if seq_starts is not None:
+        if seq_starts.dtype not in (torch.int32, torch.int64):
+            raise ValueError("seq_starts must be int32 or int64")
+        if seq_starts.ndim != 1 or seq_starts.shape[0] < batch_size:
+            raise ValueError("seq_starts must be [batch_size]")
+    if dst.dtype != torch.bfloat16 or dst.ndim != 2 or dst.shape[1] != _D_NOPE:
+        raise ValueError(f"dst must be bf16 [num_tokens, 512], got {tuple(dst.shape)}")
+    _validate_cpu_workspace_starts(workspace_starts, batch_size, dst.shape[0])
+    _, gather = get_sparse_mla_sm89_compat_cache_module()
+    gather(kv_cache, dst, block_table, workspace_starts, batch_size, seq_starts)
