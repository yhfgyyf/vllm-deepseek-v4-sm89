+            global_cache, global_slots, 64, global_cache.stride(0), 288, 288
+        )
+        global_decoded = _decode_global(global_rows.flatten(0, 1)).unflatten(
+            0, global_slots.shape
+        )
+
+    expected = torch.empty_like(actual)
+    for token in range(num_tokens):
+        valid_swa = (swa_slots[token] >= 0) & (swa_slots[token] < 64)
+        kv = swa_decoded[token, valid_swa].to(torch.bfloat16)
+        if with_global:
+            assert global_slots is not None
+            valid_global = (global_slots[token] >= 0) & (global_slots[token] < 128)
+            kv = torch.cat((kv, global_decoded[token, valid_global].to(torch.bfloat16)))
+        logits = q[token].float() @ kv.float().T * scale
+        logits = torch.cat((logits, sinks[:, None]), dim=1)
+        probs = logits.softmax(dim=1)[:, :-1].to(torch.bfloat16)
+        expected[token] = (probs.float() @ kv.float()).to(torch.bfloat16)
+    torch.testing.assert_close(actual, expected, rtol=3e-2, atol=3e-2)
