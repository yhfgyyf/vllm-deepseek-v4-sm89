+    swa_page_stride, swa_row_stride = 32 * 544 + 64, 544
+    global_page_stride, global_row_stride = 128 * 304 + 128, 304
+    swa_backing = torch.full(
+        (4 * swa_page_stride,), 0xA5, dtype=torch.uint8, device=device
+    )
+    swa_cache = swa_backing.as_strided(
+        (4, 32, 544), (swa_page_stride, swa_row_stride, 1)
+    )
+    global_backing = torch.full(
+        (4 * global_page_stride,), 0xA5, dtype=torch.uint8, device=device
+    )
+    global_cache = global_backing.as_strided(
+        (4, 128, 304), (global_page_stride, global_row_stride, 1)
+    )
+    swa_kv = torch.randn(swa_rows, 512, dtype=torch.bfloat16, device=device)
+    global_kv = torch.randn(global_rows, 512, dtype=torch.bfloat16, device=device)
+    deepseek_v41_pack_swa_cache(
+        swa_kv,
+        torch.arange(swa_rows, dtype=torch.int32, device=device),
+        swa_cache,
+    )
+    deepseek_v41_pack_global_cache(
+        global_kv,
+        torch.arange(global_rows, dtype=torch.int64, device=device),
+        global_cache,
+    )
+    swa_slots = torch.stack(
+        [
+            torch.arange(swa_rows, dtype=torch.int32, device=device).roll(t)
+            for t in range(num_tokens)
+        ]
+    )
+    global_slots = torch.stack(
+        [
+            torch.arange(global_rows, dtype=torch.int64, device=device).roll(3 * t)
+            for t in range(num_tokens)
+        ]
+    )
+    q = torch.randn(num_tokens, num_heads, 512, dtype=torch.bfloat16, device=device)
+    q[..., -32:] = torch.arange(32, device=device) / 32
+    sinks = torch.linspace(-1, 1, num_heads, dtype=torch.float32, device=device)
+    workspace = torch.empty(
+        deepseek_v41_mixed_sparse_workspace_size(
+            num_tokens, num_heads, swa_rows, global_rows
+        ),
+        dtype=torch.uint8,
+        device=device,
+    )
+    actual = deepseek_v41_mixed_sparse_attention(
+        q,
+        swa_cache,
+        global_cache,
+        swa_slots,
+        global_slots,
+        512**-0.5,
+        sinks,
+        workspace=workspace,
+    )
+
+    swa_pool = _decode_swa(
+        _gather(
+            swa_cache,
+            torch.arange(swa_rows, device=device)[None],
+            32,
+            swa_page_stride,
+            swa_row_stride,
+            528,
+        )[0]
+    )
+    global_pool = _decode_global(
+        _gather(
+            global_cache,
+            torch.arange(global_rows, device=device)[None],
+            128,
+            global_page_stride,
+            global_row_stride,
