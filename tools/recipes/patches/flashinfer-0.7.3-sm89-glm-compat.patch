+// Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include <cuda_bf16.h>
+#include <cuda_fp8.h>
+#include <cuda_runtime.h>
+
+#include "tvm_ffi_utils.h"
+
+using tvm::ffi::Optional;
+
+namespace flashinfer::sparse_mla_sm89_compat_cache {
+
+constexpr int kDNope = 512;
+constexpr int kTileSize = 128;
+constexpr int kNumTiles = 4;
+constexpr int kScaleBytes = kNumTiles * static_cast<int>(sizeof(float));
+constexpr int kBytesPerToken = kDNope + kScaleBytes;
+constexpr float kFp8E4M3Max = 448.0f;
+
+struct PagedKVLayout {
+  int page_block_size;
+  int64_t num_blocks;
+  int64_t stride_block;
+  int64_t stride_token;
+};
+
+inline PagedKVLayout parse_kv_layout(const TensorView& kv_cache) {
+  CHECK_CUDA(kv_cache);
+  TVM_FFI_ICHECK_EQ(kv_cache.dtype(), dl_uint8) << "kv_cache must be uint8";
+  TVM_FFI_ICHECK_GE(kv_cache.ndim(), 2) << "kv_cache must have at least 2 dims";
+  TVM_FFI_ICHECK_LE(kv_cache.ndim(), 4) << "kv_cache must have at most 4 dims";
+  if (kv_cache.ndim() == 2) {
+    TVM_FFI_ICHECK_EQ(kv_cache.size(1) % kBytesPerToken, 0)
+        << "2D kv_cache width must be divisible by 528";
+    return {static_cast<int>(kv_cache.size(1) / kBytesPerToken), kv_cache.size(0),
+            kv_cache.stride(0), kBytesPerToken};
+  }
+
+  TVM_FFI_ICHECK_EQ(kv_cache.size(-1), kBytesPerToken)
+      << "GLM NoPE cache last dim must be 528 bytes";
+  TVM_FFI_ICHECK_EQ(kv_cache.stride(-1), 1) << "kv_cache last dim must be contiguous";
+  if (kv_cache.ndim() == 3) {
+    return {static_cast<int>(kv_cache.size(1)), kv_cache.size(0), kv_cache.stride(0),
+            kv_cache.stride(1)};
+  }
+
+  if (kv_cache.size(1) == 1) {
+    return {static_cast<int>(kv_cache.size(2)), kv_cache.size(0), kv_cache.stride(0),
+            kv_cache.stride(2)};
+  }
+  TVM_FFI_ICHECK_EQ(kv_cache.size(2), 1)
+      << "4D kv_cache must be HND [B,1,block,528] or NHD [B,block,1,528]";
+  return {static_cast<int>(kv_cache.size(1)), kv_cache.size(0), kv_cache.stride(0),
+          kv_cache.stride(1)};
+}
+
+__device__ __forceinline__ uint8_t fp8_e4m3_to_byte(float x) {
+  const __nv_fp8_e4m3 fp8(x);
+  return *reinterpret_cast<const uint8_t*>(&fp8);
+}
+
+__device__ __forceinline__ float byte_to_fp8_e4m3(uint8_t x) {
+  const __nv_fp8_e4m3 fp8 = *reinterpret_cast<const __nv_fp8_e4m3*>(&x);
+  return static_cast<float>(fp8);
+}
+
+__global__ void pack_glm_nope_kernel(const __nv_bfloat16* __restrict__ kv,
+                                     const int64_t* __restrict__ slot_mapping,
+                                     uint8_t* __restrict__ kv_cache, int num_tokens,
+                                     int64_t kv_stride_token, int page_block_size,
+                                     int64_t num_blocks, int64_t cache_stride_block,
+                                     int64_t cache_stride_token) {
+  const int token_idx = blockIdx.x;
+  const int tile_idx = blockIdx.y;
+  const int tid = threadIdx.x;
+  if (token_idx >= num_tokens || tile_idx >= kNumTiles) {
+    return;
+  }
+
+  const int64_t slot = slot_mapping[token_idx];
+  if (slot < 0 || slot >= num_blocks * static_cast<int64_t>(page_block_size)) {
+    return;
+  }
+
+  const __nv_bfloat16* src = kv + token_idx * kv_stride_token + tile_idx * kTileSize;
+  float value = 0.0f;
+  if (tid < kTileSize) {
+    value = fabsf(__bfloat162float(src[tid]));
+  }
+
+  __shared__ float reduce[kTileSize];
+  reduce[tid] = value;
+  __syncthreads();
+  for (int stride = kTileSize / 2; stride > 0; stride >>= 1) {
+    if (tid < stride) {
+      reduce[tid] = fmaxf(reduce[tid], reduce[tid + stride]);
+    }
+    __syncthreads();
+  }
+
+  const float scale = fmaxf(reduce[0], 1.0e-4f) / kFp8E4M3Max;
+  const int64_t block = slot / page_block_size;
+  const int64_t offset = slot - block * page_block_size;
+  uint8_t* dst = kv_cache + block * cache_stride_block + offset * cache_stride_token;
+
+  if (tid < kTileSize) {
+    const float quantized = __bfloat162float(src[tid]) / scale;
+    dst[tile_idx * kTileSize + tid] = fp8_e4m3_to_byte(quantized);
+  }
+  if (tid == 0) {
+    reinterpret_cast<float*>(dst + kDNope)[tile_idx] = scale;
+  }
+}
+
+template <typename StartT, typename SeqStartT>
+__global__ void gather_glm_nope_kernel(const uint8_t* __restrict__ kv_cache,
+                                       __nv_bfloat16* __restrict__ out,
+                                       const int32_t* __restrict__ block_table,
+                                       const StartT* __restrict__ workspace_starts,
+                                       const SeqStartT* __restrict__ seq_starts,
+                                       int batch_size, int max_blocks_per_seq,
+                                       int64_t out_num_tokens, int64_t num_blocks,
+                                       int page_block_size, int64_t cache_stride_block,
+                                       int64_t cache_stride_token, int64_t out_stride_token) {
+  const int batch_idx = blockIdx.x;
+  const int dim = threadIdx.x;
+  if (batch_idx >= batch_size || dim >= kDNope) {
+    return;
+  }
+
+  const int64_t row_start = static_cast<int64_t>(workspace_starts[batch_idx]);
+  const int64_t row_end = static_cast<int64_t>(workspace_starts[batch_idx + 1]);
+  const int64_t safe_row_start = row_start > 0 ? row_start : 0;
+  const int64_t safe_row_end = row_end < out_num_tokens ? row_end : out_num_tokens;
+  if (safe_row_end <= safe_row_start) {
+    return;
+  }
+  const int64_t seq_start =
+      seq_starts == nullptr ? 0 : static_cast<int64_t>(seq_starts[batch_idx]);
+  for (int64_t row = safe_row_start; row < safe_row_end; ++row) {
+    const int64_t pos = seq_start + row - row_start;
+    const int64_t logical_block = pos / page_block_size;
+    const int token_offset = static_cast<int>(pos - logical_block * page_block_size);
+    if (logical_block < 0 || logical_block >= max_blocks_per_seq) {
+      out[row * out_stride_token + dim] = __float2bfloat16(0.0f);
+      continue;
+    }
+
+    const int32_t physical_block =
+        block_table[static_cast<int64_t>(batch_idx) * max_blocks_per_seq + logical_block];
+    if (physical_block < 0 || static_cast<int64_t>(physical_block) >= num_blocks) {
+      out[row * out_stride_token + dim] = __float2bfloat16(0.0f);
+      continue;
+    }
+
+    const uint8_t* src =
+        kv_cache + static_cast<int64_t>(physical_block) * cache_stride_block +
+        static_cast<int64_t>(token_offset) * cache_stride_token;
+    const int tile_idx = dim / kTileSize;
+    const float scale = reinterpret_cast<const float*>(src + kDNope)[tile_idx];
+    const float x = byte_to_fp8_e4m3(src[dim]) * scale;
+    out[row * out_stride_token + dim] = __float2bfloat16(x);
+  }
+}
+
+void SparseMlaSm120PackGlmNopeCache(TensorView kv, TensorView slot_mapping,
+                                    TensorView kv_cache) {
+  CHECK_CUDA(kv);
+  CHECK_CUDA(slot_mapping);
+  CHECK_DEVICE(kv, slot_mapping);
+  CHECK_DEVICE(kv, kv_cache);
+  TVM_FFI_ICHECK_EQ(kv.dtype(), dl_bfloat16) << "kv must be bf16";
+  TVM_FFI_ICHECK_EQ(slot_mapping.dtype(), dl_int64) << "slot_mapping must be int64";
+  TVM_FFI_ICHECK_EQ(kv.ndim(), 2) << "kv must be [num_tokens, 512]";
+  TVM_FFI_ICHECK_EQ(slot_mapping.ndim(), 1) << "slot_mapping must be [num_tokens]";
+  TVM_FFI_ICHECK_EQ(kv.size(1), kDNope) << "kv last dim must be 512";
+  TVM_FFI_ICHECK_EQ(kv.stride(1), 1) << "kv last dim must be contiguous";
+  TVM_FFI_ICHECK_LE(slot_mapping.size(0), kv.size(0))
+      << "slot_mapping cannot contain more entries than kv tokens";
+
+  const PagedKVLayout layout = parse_kv_layout(kv_cache);
+  // vLLM may pad the projected KV tensor for CUDA graphs while keeping
+  // slot_mapping at the actual token count.
+  const int num_tokens = static_cast<int>(slot_mapping.size(0));
+  if (num_tokens == 0) {
+    return;
+  }
+
+  ffi::CUDADeviceGuard device_guard(kv.device().device_id);
+  const cudaStream_t stream = get_stream(kv.device());
+  const dim3 grid(num_tokens, kNumTiles);
+  pack_glm_nope_kernel<<<grid, kTileSize, 0, stream>>>(
+      static_cast<const __nv_bfloat16*>(kv.data_ptr()),
+      static_cast<const int64_t*>(slot_mapping.data_ptr()),
+      static_cast<uint8_t*>(kv_cache.data_ptr()), num_tokens, kv.stride(0),
+      layout.page_block_size, layout.num_blocks, layout.stride_block, layout.stride_token);
+  TVM_FFI_ICHECK_EQ(cudaPeekAtLastError(), cudaSuccess)
+      << "sparse_mla_sm89_compat_pack_glm_nope_cache launch failed";
+}
+
+template <typename StartT, typename SeqStartT>
+void launch_gather(TensorView kv_cache, TensorView out, TensorView block_table,
+                   TensorView workspace_starts, Optional<TensorView> seq_starts,
+                   int64_t batch_size, const PagedKVLayout& layout, cudaStream_t stream) {
+  const SeqStartT* seq_starts_ptr =
+      seq_starts.has_value() ? static_cast<const SeqStartT*>(seq_starts.value().data_ptr())
+                             : nullptr;
+  gather_glm_nope_kernel<StartT, SeqStartT>
+      <<<static_cast<int>(batch_size), kDNope, 0, stream>>>(
+      static_cast<const uint8_t*>(kv_cache.data_ptr()),
+      static_cast<__nv_bfloat16*>(out.data_ptr()),
+      static_cast<const int32_t*>(block_table.data_ptr()),
+      static_cast<const StartT*>(workspace_starts.data_ptr()), seq_starts_ptr,
+      static_cast<int>(batch_size), static_cast<int>(block_table.size(1)), out.size(0),
+      layout.num_blocks, layout.page_block_size, layout.stride_block, layout.stride_token,
+      out.stride(0));
+}
+
+void SparseMlaSm120GatherGlmNopeCache(TensorView kv_cache, TensorView out,
+                                      TensorView block_table, TensorView workspace_starts,
+                                      int64_t batch_size, Optional<TensorView> seq_starts) {
+  CHECK_CUDA(kv_cache);
+  CHECK_CUDA(out);
+  CHECK_CUDA(block_table);
+  CHECK_CUDA(workspace_starts);
+  CHECK_DEVICE(kv_cache, block_table);
+  CHECK_DEVICE(kv_cache, workspace_starts);
+  CHECK_DEVICE(kv_cache, out);
+  if (seq_starts.has_value()) {
+    CHECK_CUDA(seq_starts.value());
+    CHECK_DEVICE(kv_cache, seq_starts.value());
+  }
+  TVM_FFI_ICHECK_EQ(block_table.dtype(), dl_int32) << "block_table must be int32";
+  TVM_FFI_ICHECK(workspace_starts.dtype() == dl_int32 || workspace_starts.dtype() == dl_int64)
+      << "workspace_starts must be int32 or int64";
+  if (seq_starts.has_value()) {
+    TVM_FFI_ICHECK(seq_starts.value().dtype() == dl_int32 ||
+                   seq_starts.value().dtype() == dl_int64)
+        << "seq_starts must be int32 or int64";
+  }
+  TVM_FFI_ICHECK_EQ(out.dtype(), dl_bfloat16) << "out must be bf16";
+  TVM_FFI_ICHECK_EQ(block_table.ndim(), 2) << "block_table must be [num_seqs, max_blocks]";
+  TVM_FFI_ICHECK_EQ(workspace_starts.ndim(), 1)
+      << "workspace_starts must be [batch_size + 1]";
+  TVM_FFI_ICHECK_EQ(out.ndim(), 2) << "out must be [num_tokens, 512]";
+  TVM_FFI_ICHECK_EQ(out.size(1), kDNope) << "out last dim must be 512";
+  TVM_FFI_ICHECK_EQ(out.stride(1), 1) << "out last dim must be contiguous";
+  TVM_FFI_ICHECK_GE(batch_size, 0) << "batch_size must be non-negative";
+  TVM_FFI_ICHECK_LE(batch_size, block_table.size(0))
+      << "batch_size cannot exceed block_table.size(0)";
+  TVM_FFI_ICHECK_GE(workspace_starts.size(0), batch_size + 1)
+      << "workspace_starts must have at least batch_size + 1 elements";
+  if (seq_starts.has_value()) {
+    TVM_FFI_ICHECK_GE(seq_starts.value().size(0), batch_size)
+        << "seq_starts must have at least batch_size elements";
+  }
+
+  const PagedKVLayout layout = parse_kv_layout(kv_cache);
+  if (batch_size == 0 || out.size(0) == 0) {
+    return;
+  }
+
+  ffi::CUDADeviceGuard device_guard(kv_cache.device().device_id);
+  const cudaStream_t stream = get_stream(kv_cache.device());
+  const bool starts_i64 = workspace_starts.dtype() == dl_int64;
+  const bool seq_i64 = !seq_starts.has_value() || seq_starts.value().dtype() == dl_int64;
+  if (starts_i64 && seq_i64) {
+    launch_gather<int64_t, int64_t>(kv_cache, out, block_table, workspace_starts, seq_starts,
+                                    batch_size, layout, stream);
+  } else if (starts_i64) {
+    launch_gather<int64_t, int32_t>(kv_cache, out, block_table, workspace_starts, seq_starts,
+                                    batch_size, layout, stream);
+  } else if (seq_i64) {
+    launch_gather<int32_t, int64_t>(kv_cache, out, block_table, workspace_starts, seq_starts,
+                                    batch_size, layout, stream);
+  } else {
+    launch_gather<int32_t, int32_t>(kv_cache, out, block_table, workspace_starts, seq_starts,
+                                    batch_size, layout, stream);
+  }
+  TVM_FFI_ICHECK_EQ(cudaPeekAtLastError(), cudaSuccess)
+      << "sparse_mla_sm89_compat_gather_glm_nope_cache launch failed";
+}
+
+}  // namespace flashinfer::sparse_mla_sm89_compat_cache
+
+TVM_FFI_DLL_EXPORT_TYPED_FUNC(
+    sparse_mla_sm89_compat_pack_glm_nope_cache,
+    flashinfer::sparse_mla_sm89_compat_cache::SparseMlaSm120PackGlmNopeCache);
+TVM_FFI_DLL_EXPORT_TYPED_FUNC(
+    sparse_mla_sm89_compat_gather_glm_nope_cache,
+    flashinfer::sparse_mla_sm89_compat_cache::SparseMlaSm120GatherGlmNopeCache);
diff --git a/csrc/sparse_mla_sm89_compat_decode_dsv3_2.cu b/csrc/sparse_mla_sm89_compat_decode_dsv3_2.cu
new file mode 100644
--- /dev/null
+++ b/csrc/sparse_mla_sm89_compat_decode_dsv3_2.cu
@@ -0,0 +1,186 @@
+// Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: BSD-3-Clause
+
+// V32 (DSv3.2) decode — forked from decode-dsv4. Warp-spec (1 IO + 8 math =
+// 288 threads), TMA bulk gather of FP8 INLINE 656 B/token KV cache, double
+// buffered with per-buffer mbarrier pairs, static grid (num_tokens × HBLOCKS
+// × num_splits). Reuses decode-dsv4's merge kernel for split combine.
+//
+// Supports the full V32-family dispatch grid:
+//   num_heads ∈ {8, 16, 32, 64, 128}
+//   topk      ∈ {128, 512, 1024, 2048}
+//   pbs       = 64
+// plus GLM NoPE's vLLM runtime shape:
+//   topk      = 2176
+//   pbs       = 64
+
+#include <cuda_runtime.h>
+
+#include <cstdio>
+#include <flashinfer/attention/sparse_mla_sm89_compat/decode_dsv3_2_kernel.cuh>
+#include <flashinfer/attention/sparse_mla_sm89_compat/decode_dsv4_kernel.cuh>  // merge kernel
+#include <flashinfer/attention/sparse_mla_sm89_compat/model/kv_cache_traits.cuh>
+
+namespace flashinfer::sparse_mla_sm89_compat {
+
+#define DSV3_2_CUDA_CHECK(call)                                             \
+  do {                                                                      \
+    cudaError_t e = (call);                                                 \
+    if (e != cudaSuccess) {                                                 \
+      printf("CUDA %s:%d %s\n", __FILE__, __LINE__, cudaGetErrorString(e)); \
+      return false;                                                         \
+    }                                                                       \
+  } while (0)
+
+template <ModelType MT, int NUM_HEADS, int TOPK, int PAGE_BLOCK_SIZE>
+static bool launch_decode_dsv3_2_impl(const bf16* Q, const uint8_t* KV_cache,
+                                      const int32_t* indices, bf16* mid_out, float* mid_lse,
+                                      const int* topk_length, bf16* output, float* out_lse,
+                                      const float* attn_sink, int num_tokens, int num_splits,
+                                      int chunks_per_block_override, float sm_scale,
+                                      size_t stride_kv_block, cudaStream_t stream) {
+  using KV = KVCacheTraits<MT>;
+  static_assert(KV::D_QK == 576 || KV::D_QK == 512);
+  constexpr int H_BLOCKS = (NUM_HEADS + HPB - 1) / HPB;
+
+  // Dynamic smem layout (must match decode_dsv3_2_kernel.cuh exactly).
+  //   sm_q_rope    HPB * D_ROPE * 2B               = 2 KB
+  //   sm_q_fp8     HPB * Q_NOPE_STRIDE             = 8.25 KB
+  //   sm_q_sc      HPB * NUM_SCALES * 4B           = 256 B
+  //   sm_kv_fp8    2 * BI * KV_SMEM_STRIDE         = 66 KB (NoPE + INLINE scales)
+  //   sm_kv_rope   2 * BI * D_ROPE * 2B            = 16 KB
+  //   mbar pad+barriers                            = 48 B
+  //   sm_reduce    2 * N_WARPS * HPB * 4           = 1 KB
+  //   sm_w_head_sc N_V_CHUNKS * HPB * 4            = 256 B
+  //   sm_w_fp8 ×2  2 * HPB * (BI + 16)             = 2.5 KB
+  // Plus static sm_p_full HPB * BI * 2B            = 2 KB
+  // Grand total ≈ 98 KB (under 99 KB sm120a carveout, 1 block/SM).
+  constexpr int N_V_CHUNKS_LAUNCH = KV::D_NOPE / KV::QUANT_TILE;  // 4
+  constexpr int DYN_SMEM_BYTES =
+      HPB * KV::D_ROPE * (int)sizeof(bf16)                    // sm_q_rope
+      + HPB * KV::Q_NOPE_STRIDE                               // sm_q_fp8
+      + HPB * KV::NUM_SCALES * (int)sizeof(float)             // sm_q_sc
+      + DSV3_2_KV_BUF_COUNT * DSV3_2_BI * KV::KV_SMEM_STRIDE  // sm_kv_fp8 ×2 (NoPE + INLINE scales)
+      + DSV3_2_KV_BUF_COUNT * DSV3_2_BI * KV::D_ROPE * (int)sizeof(bf16)  // sm_kv_rope ×2
+      + 16                                                                // mbar align pad
+      + 4 * (int)sizeof(uint64_t)                                         // mbar_full + mbar_empty
+      + 2 * DSV3_2_N_WARPS * HPB * (int)sizeof(float)                     // sm_reduce
+      + N_V_CHUNKS_LAUNCH * HPB * (int)sizeof(float)                      // sm_w_head_sc
+      + 2 * HPB * (DSV3_2_BI + 16);                                       // sm_w_fp8 ×2
+
+  auto kernel = sparse_mla_decode_dsv3_2_kernel<MT, NUM_HEADS, TOPK, PAGE_BLOCK_SIZE>;
+  DSV3_2_CUDA_CHECK(
+      cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, DYN_SMEM_BYTES));
+
+  // chunks_per_block heuristic identical to decode-dsv4: among cpb candidates
+  // with at most CEIL_WAVES_MAX integer waves, minimize the last-wave tail
+  // gap; ties broken by largest cpb (fewer launched blocks contending on L2).
+  int chunks_per_block;
+  if (chunks_per_block_override >= 1 && chunks_per_block_override <= num_splits) {
+    chunks_per_block = chunks_per_block_override;
+  } else {
+    int sm_count = 0;
+    int device = 0;
+    DSV3_2_CUDA_CHECK(cudaGetDevice(&device));
+    DSV3_2_CUDA_CHECK(cudaDeviceGetAttribute(&sm_count, cudaDevAttrMultiProcessorCount, device));
+    if (sm_count <= 0) sm_count = 188;
+    constexpr int CEIL_WAVES_MAX = 3;
+    const int per_token_head = num_tokens * H_BLOCKS;
+    chunks_per_block = 1;
+    float best_gap = 2.0f;
+    for (int cpb = 1; cpb <= num_splits; ++cpb) {
+      const int eff = (num_splits + cpb - 1) / cpb;
+      const int active = per_token_head * eff;
+      const int ceil_w = (active + sm_count - 1) / sm_count;
+      if (ceil_w > CEIL_WAVES_MAX) continue;
+      const float waves = (float)active / (float)sm_count;
+      const float gap = (float)ceil_w - waves;
+      if (gap < best_gap - 1e-6f || (gap < best_gap + 1e-6f && cpb > chunks_per_block)) {
+        best_gap = gap;
+        chunks_per_block = cpb;
+      }
+    }
+  }
+
+  // Launch the full Python-allocated num_splits grid. Inactive splits return
+  // early after marking LSE = -inf — keeps mid_out/mid_lse stride aligned with
+  // wrapper allocation.
+  dim3 grid1(num_tokens, H_BLOCKS, num_splits);
+  dim3 block1(DSV3_2_BLOCK_THREADS);
+  kernel<<<grid1, block1, DYN_SMEM_BYTES, stream>>>(Q, KV_cache, indices, mid_out, mid_lse,
+                                                    topk_length, num_tokens, num_splits,
+                                                    chunks_per_block, sm_scale, stride_kv_block);
+  DSV3_2_CUDA_CHECK(cudaGetLastError());
+
+  // Stage 2: reuse decode-dsv4 merge kernel (D_V=512 identical for both).
+  constexpr int MERGE_BLOCK_THREADS = 64;
+  constexpr int MERGE_DIMS_PER_THREAD = KV::D_V / MERGE_BLOCK_THREADS;
+  auto merge_kernel = sparse_mla_decode_dsv4_merge_kernel<NUM_HEADS, KV::D_V, MERGE_BLOCK_THREADS,
+                                                          MERGE_DIMS_PER_THREAD>;
+  dim3 grid2(num_tokens, NUM_HEADS);
+  dim3 block2(MERGE_BLOCK_THREADS);
+  const size_t merge_smem_bytes = (size_t)num_splits * sizeof(float);
+  merge_kernel<<<grid2, block2, merge_smem_bytes, stream>>>(mid_out, mid_lse, output, out_lse,
+                                                            attn_sink, num_tokens, num_splits);
+  DSV3_2_CUDA_CHECK(cudaGetLastError());
+  return true;
+}
+
+// Public surface: V32-family (DSv3.2 / GLM_NSA) decode.
+// Returns false if (num_heads, topk) is outside the dispatch envelope.
+bool launch_sparse_mla_decode_dsv3_2(ModelType mt, int num_heads, int topk, int page_block_size,
+                                     int num_tokens, int num_splits, const bf16* Q,
+                                     const uint8_t* KV_cache, const int32_t* indices,
+                                     bf16* mid_out, float* mid_lse, bf16* output, float* out_lse,
+                                     const int* topk_length, const float* attn_sink,
+                                     int chunks_per_block_override, float sm_scale,
+                                     size_t stride_kv_block, cudaStream_t stream) {
+  if (num_splits <= 0) return false;
+#define DSV3_2_DISPATCH_MT(MT_VALUE, H, K, PBS)                                                \
+  if (num_heads == (H) && topk == (K) && page_block_size == (PBS)) {                           \
+    return launch_decode_dsv3_2_impl<MT_VALUE, (H), (K), (PBS)>(                               \
+        Q, KV_cache, indices, mid_out, mid_lse, topk_length, output, out_lse, attn_sink,       \
+        num_tokens, num_splits, chunks_per_block_override, sm_scale, stride_kv_block, stream); \
+  }
+#define DSV3_2_DISPATCH(H, K)                      \
+  do {                                             \
+    if (mt == ModelType::DSV3_2) {                 \
+      DSV3_2_DISPATCH_MT(ModelType::DSV3_2, H, K, 64)  \
+    } else if (mt == ModelType::GLM_NSA) {         \
+      DSV3_2_DISPATCH_MT(ModelType::GLM_NSA, H, K, 64) \
+    } else if (mt == ModelType::GLM_NOPE) {        \
+      DSV3_2_DISPATCH_MT(ModelType::GLM_NOPE, H, K, 64) \
+    }                                              \
+  } while (0);
+#define GLM_NOPE_DISPATCH_2176(H) DSV3_2_DISPATCH_MT(ModelType::GLM_NOPE, H, 2176, 64)
+  DSV3_2_DISPATCH(8, 128)
+  DSV3_2_DISPATCH(8, 512)
+  DSV3_2_DISPATCH(8, 1024)
+  DSV3_2_DISPATCH(8, 2048)
+  GLM_NOPE_DISPATCH_2176(8)
+  DSV3_2_DISPATCH(16, 128)
+  DSV3_2_DISPATCH(16, 512)
+  DSV3_2_DISPATCH(16, 1024)
+  DSV3_2_DISPATCH(16, 2048)
+  GLM_NOPE_DISPATCH_2176(16)
+  DSV3_2_DISPATCH(32, 128)
+  DSV3_2_DISPATCH(32, 512)
+  DSV3_2_DISPATCH(32, 1024)
+  DSV3_2_DISPATCH(32, 2048)
+  GLM_NOPE_DISPATCH_2176(32)
+  DSV3_2_DISPATCH(64, 128)
+  DSV3_2_DISPATCH(64, 512)
+  DSV3_2_DISPATCH(64, 1024)
+  DSV3_2_DISPATCH(64, 2048)
+  GLM_NOPE_DISPATCH_2176(64)
+  DSV3_2_DISPATCH(128, 128)
+  DSV3_2_DISPATCH(128, 512)
+  DSV3_2_DISPATCH(128, 1024)
+  DSV3_2_DISPATCH(128, 2048)
+#undef GLM_NOPE_DISPATCH_2176
+#undef DSV3_2_DISPATCH
+#undef DSV3_2_DISPATCH_MT
+  return false;
+}
+
+}  // namespace flashinfer::sparse_mla_sm89_compat
diff --git a/csrc/sparse_mla_sm89_compat_decode_dsv4.cu b/csrc/sparse_mla_sm89_compat_decode_dsv4.cu
new file mode 100644
--- /dev/null
+++ b/csrc/sparse_mla_sm89_compat_decode_dsv4.cu
@@ -0,0 +1,193 @@
+// Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include <cuda_runtime.h>
+
+#include <cstdio>
+#include <flashinfer/attention/sparse_mla_sm89_compat/decode_dsv4_kernel.cuh>
+#include <flashinfer/attention/sparse_mla_sm89_compat/model/kv_cache_traits.cuh>
+
+namespace flashinfer::sparse_mla_sm89_compat {
+
+#define CUDA_CHECK_BOOL(call)                                               \
+  do {                                                                      \
+    cudaError_t e = (call);                                                 \
+    if (e != cudaSuccess) {                                                 \
+      printf("CUDA %s:%d %s\n", __FILE__, __LINE__, cudaGetErrorString(e)); \
+      return false;                                                         \
+    }                                                                       \
+  } while (0)
+
+template <ModelType MT, int NUM_HEADS, int TOPK, int PAGE_BLOCK_SIZE>
+static bool launch_decode_dsv4_impl(const bf16* Q, const uint8_t* KV_cache, const int32_t* indices,
+                                    bf16* mid_out, float* mid_lse, const int* topk_length,
+                                    bf16* output, float* out_lse, const float* attn_sink,
+                                    const uint8_t* extra_KV_cache, const int32_t* extra_indices,
+                                    const int* extra_topk_length, int extra_topk, int pbs_extra,
+                                    size_t stride_extra_kv_block, int num_tokens, int num_splits,
+                                    int chunks_per_block_override, float sm_scale,
+                                    size_t stride_kv_block, cudaStream_t stream) {
+  using KV = KVCacheTraits<MT>;
+  // Ceiling div so NUM_HEADS < HPB (small-TP configs, e.g. h=8) still get a
+  // tile. The kernel internally clamps Q load + mid_out writes to
+  // VALID_HPB = min(NUM_HEADS, HPB).
+  constexpr int H_BLOCKS = (NUM_HEADS + HPB - 1) / HPB;
+
+  // Stage 1: decode-dsv4 (A1.2) partial-output kernel.
+  // Dynamic smem layout (FP8 XV, DSV4, DSV4_BI=64, double-buffered KV):
+  //   sm_q_rope    HPB * D_ROPE * 2B                      =  2 KB
+  //   sm_q_fp8     HPB * Q_NOPE_STRIDE                    = 7.25 KB
+  //   sm_q_sc      HPB * NUM_SCALES * 4B                  = 0.44 KB
+  //   sm_kv_fp8    2 * DSV4_BI * KV_SMEM_STRIDE             = 58 KB
+  //   sm_kv_sc     2 * DSV4_BI * SCALE_BYTES_PER_TOKEN      =  1 KB
+  //   sm_kv_rope   2 * DSV4_BI * D_ROPE * 2B                = 16 KB
+  //   sm_reduce    2 * DSV4_N_WARPS * HPB * 4               = 1 KB
+  //   sm_w_head_sc N_V_CHUNKS * HPB * 4                   = 448 B
+  //   sm_w_fp8 ×2  2 * HPB * (DSV4_BI + 16)                 = 2.5 KB
+  //   Total                                               ~ 88 KB
+  // Static smem (kernel-side):
+  //   sm_p_full    HPB * DSV4_BI * 2B (bf16)                =  2 KB
+  // Grand total ~ 89 KB (under 100 KB SM120 carveout, 1 block/SM).
+  constexpr int N_V_CHUNKS_LAUNCH = KV::D_NOPE / KV::QUANT_TILE;  // 7
+  constexpr int DYN_SMEM_BYTES =
+      HPB * KV::D_ROPE * (int)sizeof(bf16)                            // sm_q_rope
+      + HPB * KV::Q_NOPE_STRIDE                                       // sm_q_fp8
+      + HPB * KV::NUM_SCALES * (int)sizeof(float)                     // sm_q_sc
+      + DSV4_KV_BUF_COUNT * DSV4_BI * KV::KV_SMEM_STRIDE              // sm_kv_fp8 ×2
+      + DSV4_KV_BUF_COUNT * DSV4_BI * KV::SCALE_BYTES_PER_TOKEN       // sm_kv_sc ×2
+      + DSV4_KV_BUF_COUNT * DSV4_BI * KV::D_ROPE * (int)sizeof(bf16)  // sm_kv_rope ×2
+      + 16                                                            // mbar align pad
+      + 4 * (int)sizeof(uint64_t)                                     // mbar_full+empty
+      + 2 * DSV4_N_WARPS * HPB * (int)sizeof(float)                   // sm_reduce
+      + N_V_CHUNKS_LAUNCH * HPB * (int)sizeof(float)                  // sm_w_head_sc
+      + 2 * HPB * (DSV4_BI + 16);                                     // sm_w_fp8 ×2 (vc parity)
+  static_assert(DYN_SMEM_BYTES + HPB * DSV4_BI * (int)sizeof(bf16) <= 101376,
+                "decode-dsv4 smem exceeds 99KB per-block limit");
+
+  auto kernel = sparse_mla_decode_dsv4_kernel<MT, NUM_HEADS, TOPK, PAGE_BLOCK_SIZE>;
+  CUDA_CHECK_BOOL(
+      cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, DYN_SMEM_BYTES));
+
+  // chunks_per_block heuristic: among cpb candidates with at most
+  // CEIL_WAVES_MAX integer waves, minimize the last-wave tail gap
+  // (ceil(waves) - waves). On ties, prefer the largest cpb so fewer
+  // launched blocks contend on L2. The ceil_w cap rules out cpb values
+  // whose fractional gap looks small but require many integer waves.
+  // AutoTuner can override per-shape via chunks_per_block_override.
+  int chunks_per_block;
+  if (chunks_per_block_override >= 1 && chunks_per_block_override <= num_splits) {
+    // AutoTuner / caller override path — used by SparseMlaDecodeRunner to
+    // sweep cpb tactics and pick per-shape best.
+    chunks_per_block = chunks_per_block_override;
+  } else {
+    int sm_count = 0;
+    int device = 0;
+    CUDA_CHECK_BOOL(cudaGetDevice(&device));
+    CUDA_CHECK_BOOL(cudaDeviceGetAttribute(&sm_count, cudaDevAttrMultiProcessorCount, device));
+    constexpr int CEIL_WAVES_MAX = 3;
+    const int per_token_head = num_tokens * H_BLOCKS;
+    chunks_per_block = 1;
+    float best_gap = 2.0f;
+    for (int cpb = 1; cpb <= num_splits; ++cpb) {
+      const int eff = (num_splits + cpb - 1) / cpb;
+      const int active = per_token_head * eff;
+      const int ceil_w = (active + sm_count - 1) / sm_count;
+      if (ceil_w > CEIL_WAVES_MAX) continue;
+      const float waves = (float)active / (float)sm_count;
+      const float gap = (float)ceil_w - waves;
+      if (gap < best_gap - 1e-6f || (gap < best_gap + 1e-6f && cpb > chunks_per_block)) {
+        best_gap = gap;
+        chunks_per_block = cpb;
+      }
+    }
+  }
+  int num_splits_eff = (num_splits + chunks_per_block - 1) / chunks_per_block;
+
+  // Launch the FULL Python-allocated num_splits grid blocks; inactive splits
+  // (chunk_lo >= num_chunks_total) return early after marking LSE = -inf,
+  // which is cheap. This keeps the mid_out/mid_lse stride matching Python's
+  // allocation without extra coordination.
+  (void)num_splits_eff;
+  dim3 grid1(num_tokens, H_BLOCKS, num_splits);
+  dim3 block1(DSV4_BLOCK_THREADS);
+  kernel<<<grid1, block1, DYN_SMEM_BYTES, stream>>>(
+      Q, KV_cache, indices, mid_out, mid_lse, topk_length, extra_KV_cache, extra_indices,
+      extra_topk_length, extra_topk, pbs_extra, stride_extra_kv_block, num_tokens, num_splits,
+      chunks_per_block, sm_scale, stride_kv_block);
+  CUDA_CHECK_BOOL(cudaGetLastError());
+
+  // Stage 2: merge splits → final output + LSE.
+  // Grid: (num_tokens, NUM_HEADS). One block (BLOCK_THREADS=64) covers the
+  // full D_V=512 via uint4 vec loads (8 bf16/thread × 64 threads = 512).
+  // For h=128/T=16 this is 2048 blocks vs the prior 8192 (4× fewer).
+  constexpr int MERGE_BLOCK_THREADS = 64;
+  constexpr int MERGE_DIMS_PER_THREAD = KV::D_V / MERGE_BLOCK_THREADS;
+  auto merge_kernel = sparse_mla_decode_dsv4_merge_kernel<NUM_HEADS, KV::D_V, MERGE_BLOCK_THREADS,
+                                                          MERGE_DIMS_PER_THREAD>;
+  dim3 grid2(num_tokens, NUM_HEADS);
+  dim3 block2(MERGE_BLOCK_THREADS);
+  const size_t merge_smem_bytes = (size_t)num_splits * sizeof(float);
+  merge_kernel<<<grid2, block2, merge_smem_bytes, stream>>>(mid_out, mid_lse, output, out_lse,
+                                                            attn_sink, num_tokens, num_splits);
+  CUDA_CHECK_BOOL(cudaGetLastError());
+  return true;
+}
+
+// Public surface — explicit instantiation switch over the PR-body bench grid.
+// DSV4 only. PAGE_BLOCK_SIZE in {64, 256}. NUM_HEADS ∈ {8, 16, 32, 64, 128},
+// TOPK ∈ {128, 192, 256, 512, 1024}. TOPK=192 covers the padded
+// DeepSeek-V4-Flash-0731 DSpark K=5 shape (128 SWA + 5 active draft entries),
+// while TOPK=256 covers wider DSpark configurations.
+bool launch_sparse_mla_decode_dsv4(ModelType mt, int num_heads, int topk, int page_block_size,
+                                   int num_tokens, int num_splits, const bf16* Q,
+                                   const uint8_t* KV_cache, const int32_t* indices, bf16* mid_out,
+                                   float* mid_lse, bf16* output, float* out_lse,
+                                   const int* topk_length, const float* attn_sink,
+                                   const uint8_t* extra_KV_cache, const int32_t* extra_indices,
+                                   const int* extra_topk_length, int extra_topk, int pbs_extra,
+                                   size_t stride_extra_kv_block, int chunks_per_block_override,
+                                   float sm_scale, size_t stride_kv_block, cudaStream_t stream) {
+  if (mt != ModelType::DSV4 || (page_block_size != 64 && page_block_size != 256)) return false;
+  if (num_splits <= 0) return false;
+#define DSV4_DISPATCH_PBS(H, K, PBS)                                                        \
+  if (num_heads == (H) && topk == (K) && page_block_size == (PBS)) {                        \
+    return launch_decode_dsv4_impl<ModelType::DSV4, (H), (K), (PBS)>(                       \
+        Q, KV_cache, indices, mid_out, mid_lse, topk_length, output, out_lse, attn_sink,    \
+        extra_KV_cache, extra_indices, extra_topk_length, extra_topk, pbs_extra,            \
+        stride_extra_kv_block, num_tokens, num_splits, chunks_per_block_override, sm_scale, \
+        stride_kv_block, stream);                                                           \
+  }
+#define DSV4_DISPATCH(H, K)   \
+  DSV4_DISPATCH_PBS(H, K, 64) \
+  DSV4_DISPATCH_PBS(H, K, 256)
+  DSV4_DISPATCH(8, 128)
+  DSV4_DISPATCH(8, 192)
+  DSV4_DISPATCH(8, 256)
+  DSV4_DISPATCH(8, 512)
+  DSV4_DISPATCH(8, 1024)
+  DSV4_DISPATCH(16, 128)
+  DSV4_DISPATCH(16, 192)
+  DSV4_DISPATCH(16, 256)
+  DSV4_DISPATCH(16, 512)
+  DSV4_DISPATCH(16, 1024)
+  DSV4_DISPATCH(32, 128)
+  DSV4_DISPATCH(32, 192)
+  DSV4_DISPATCH(32, 256)
+  DSV4_DISPATCH(32, 512)
+  DSV4_DISPATCH(32, 1024)
+  DSV4_DISPATCH(64, 128)
+  DSV4_DISPATCH(64, 192)
+  DSV4_DISPATCH(64, 256)
+  DSV4_DISPATCH(64, 512)
+  DSV4_DISPATCH(64, 1024)
+  DSV4_DISPATCH(128, 128)
+  DSV4_DISPATCH(128, 192)
+  DSV4_DISPATCH(128, 256)
+  DSV4_DISPATCH(128, 512)
+  DSV4_DISPATCH(128, 1024)
+#undef DSV4_DISPATCH
+#undef DSV4_DISPATCH_PBS
+  return false;
+}
+
+}  // namespace flashinfer::sparse_mla_sm89_compat
