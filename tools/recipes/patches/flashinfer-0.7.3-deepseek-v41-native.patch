+            num_heads,
+            num_splits,
+            has_global,
+            global_page_size,
+            unified_tiles,
+            block_n,
+        ),
+        target=GPUTarget("cuda", arch, 32),
+        options={"num_warps": num_warps, "num_stages": pipeline_stages},
+    )
+    return compiled.asm["ptx"], compiled.metadata.shared
+
+
+def compile_deepseek_v41_mixed_sparse_merge_ptx(
