+            sinks,
+            out=out,
+            workspace=workspace,
+        )
+
+    assert run().data_ptr() == out.data_ptr()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        run()
+
+    tensors = (
+        q,
+        swa_cache,
+        global_cache,
+        swa_slots,
+        global_slots,
+        sinks,
+        out,
+        workspace,
+    )
+    pointers = tuple(tensor.data_ptr() for tensor in tensors)
+    for replay in range(3):
+        q.copy_(torch.randn_like(q))
+        swa_kv.copy_(torch.randn_like(swa_kv))
+        global_kv.copy_(torch.randn_like(global_kv))
+        deepseek_v41_pack_swa_cache(swa_kv, swa_write_slots, swa_cache)
+        deepseek_v41_pack_global_cache(global_kv, global_write_slots, global_cache)
+        swa_pattern = torch.arange(topk, dtype=torch.int32, device=device).roll(
+            replay + 1
+        )
+        global_pattern = torch.arange(topk, dtype=torch.int64, device=device).roll(
+            3 * replay + 1
+        )
+        swa_pattern[0] = -1
+        swa_pattern[1] = swa_capacity
+        global_pattern[0] = -1
+        global_pattern[1] = global_capacity
+        swa_slots.copy_(swa_pattern[None])
