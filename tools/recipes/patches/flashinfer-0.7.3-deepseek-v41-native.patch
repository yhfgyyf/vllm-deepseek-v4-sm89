+"""DeepSeek-V4.1 mixed sparse cache and attention contracts."""
+
+from __future__ import annotations
+
+import math
+
+import pytest
+import torch
+
+from flashinfer.mla.deepseek_v41 import (
+    DEEPSEEK_V41_GLOBAL_FORMAT,
+    DEEPSEEK_V41_GLOBAL_ROW_BYTES,
+    DEEPSEEK_V41_SWA_FORMAT,
+    DEEPSEEK_V41_SWA_PAGE_SIZE,
+    DEEPSEEK_V41_SWA_ROW_BYTES,
+    _deepseek_v41_mixed_sparse_attention_with_inv_rope,
+    deepseek_v41_mixed_sparse_attention,
+    deepseek_v41_mixed_sparse_workspace_size,
+    deepseek_v41_mixed_sparse_workspace_size_upper_bound,
+    deepseek_v41_pack_global_cache,
+    deepseek_v41_pack_swa_cache,
+)
+
+
+def _fp4_decode(data: torch.Tensor) -> torch.Tensor:
+    codes = torch.stack((data & 0xF, data >> 4), dim=-1).flatten(-2)
+    levels = torch.tensor(
+        [0, 0.5, 1, 1.5, 2, 3, 4, 6], dtype=torch.float32, device=data.device
+    )
+    return levels[(codes & 7).long()] * torch.where((codes & 8) != 0, -1.0, 1.0)
+
+
+def _decode_swa(rows: torch.Tensor) -> torch.Tensor:
+    values = rows[:, :512].view(torch.float8_e4m3fn).float()
+    scales = rows[:, 512:528].view(torch.float8_e8m0fnu).float()
+    return (values.unflatten(-1, (16, 32)) * scales.unsqueeze(-1)).flatten(-2)
+
+
+def _decode_global(rows: torch.Tensor) -> torch.Tensor:
+    values = _fp4_decode(rows[:, :256]).unflatten(-1, (32, 16))
+    scales = rows[:, 256:288].view(torch.float8_e4m3fn).float()
+    return (values * scales.unsqueeze(-1)).flatten(-2)
+
+
+def _make_inverse_rope_inputs(num_tokens: int, device: torch.device):
+    num_positions = 3 * num_tokens + 11
+    positions = (
+        torch.arange(num_tokens, dtype=torch.int64, device=device) * 7 + 3
+    ) % num_positions
+    frequencies = torch.exp(
+        -torch.arange(32, dtype=torch.float32, device=device)
+        * (math.log(10_000.0) / 32)
+    )
+    angles = (
+        torch.arange(num_positions, dtype=torch.float32, device=device)[:, None]
+        * frequencies[None]
+        + 0.03125
+    )
+    return positions.contiguous(), torch.cat((angles.cos(), angles.sin()), dim=1)
+
+
+def _inverse_rope_grouped_reference(
+    attention_out: torch.Tensor,
+    positions: torch.Tensor,
+    cos_sin: torch.Tensor,
+) -> torch.Tensor:
+    rotated = attention_out.float().clone()
+    selected = cos_sin[positions.long()].float()
+    cosine = selected[:, None, :32]
+    sine = selected[:, None, 32:]
+    even = attention_out[..., -64::2].float()
+    odd = attention_out[..., -63::2].float()
+    even_cos = even * cosine
+    odd_sin = odd * sine
+    odd_cos = odd * cosine
+    even_sin = even * sine
+    rotated[..., -64::2] = even_cos + odd_sin
+    rotated[..., -63::2] = odd_cos - even_sin
+    groups = attention_out.shape[1] // 8
+    return (
+        rotated.to(torch.bfloat16)
+        .reshape(attention_out.shape[0], groups, 4096)
+        .transpose(0, 1)
+        .contiguous()
+        .transpose(0, 1)
+    )
+
+
+def _gather(storage, slots, page_size, page_stride, row_stride, payload):
+    if storage.ndim == 3:
+        last_slot = storage.shape[0] * page_size - 1
+        span = (
+            (last_slot // page_size) * page_stride
+            + (last_slot % page_size) * row_stride
+            + payload
+        )
+    else:
+        span = storage.numel()
+    flat = storage.as_strided((span,), (1,), storage.storage_offset())
+    result = torch.zeros(*slots.shape, payload, dtype=torch.uint8, device=slots.device)
+    for t in range(slots.shape[0]):
+        for i in range(slots.shape[1]):
+            slot = int(slots[t, i])
+            offset = (slot // page_size) * page_stride + (slot % page_size) * row_stride
+            if slot >= 0 and offset + payload <= flat.numel():
+                result[t, i].copy_(flat[offset : offset + payload])
+    return result
+
+
+def _attention_reference(
+    q,
+    swa_cache,
+    swa_slots,
+    sinks,
+    *,
+    global_cache=None,
+    global_slots=None,
+):
+    swa_rows = _gather(
+        swa_cache,
+        swa_slots,
+        32,
+        swa_cache.stride(0),
+        swa_cache.stride(1),
+        DEEPSEEK_V41_SWA_ROW_BYTES,
+    )
+    swa_decoded = _decode_swa(swa_rows.flatten(0, 1)).unflatten(0, swa_slots.shape)
+    swa_capacity = swa_cache.shape[0] * swa_cache.shape[1]
+
+    global_decoded = None
+    global_capacity = 0
+    if global_cache is not None and global_slots is not None:
+        global_rows = _gather(
+            global_cache,
+            global_slots,
+            global_cache.shape[1],
+            global_cache.stride(0),
+            global_cache.stride(1),
+            DEEPSEEK_V41_GLOBAL_ROW_BYTES,
+        )
+        global_decoded = _decode_global(global_rows.flatten(0, 1)).unflatten(
+            0, global_slots.shape
+        )
+        global_capacity = global_cache.shape[0] * global_cache.shape[1]
+
+    expected = torch.empty_like(q)
+    for token in range(q.shape[0]):
+        valid_swa = (swa_slots[token] >= 0) & (swa_slots[token] < swa_capacity)
+        kv = swa_decoded[token, valid_swa].to(torch.bfloat16)
+        if global_decoded is not None and global_slots is not None:
+            valid_global = (global_slots[token] >= 0) & (
+                global_slots[token] < global_capacity
+            )
+            kv = torch.cat((kv, global_decoded[token, valid_global].to(torch.bfloat16)))
+        logits = q[token].float() @ kv.float().T * (512**-0.5)
+        logits = torch.cat((logits, sinks[:, None]), dim=1)
+        probabilities = logits.softmax(dim=1)[:, :-1].to(torch.bfloat16)
+        expected[token] = (probabilities.float() @ kv.float()).to(torch.bfloat16)
+    return expected
+
+
+def test_v41_cache_format_tags_are_unambiguous():
+    assert DEEPSEEK_V41_SWA_FORMAT == "fp8_e4m3_ue8m0_g32"
+    assert DEEPSEEK_V41_GLOBAL_FORMAT == "fp4_e2m1_e4m3_g16"
+    assert DEEPSEEK_V41_SWA_ROW_BYTES == 512 + 512 // 32
+    assert DEEPSEEK_V41_GLOBAL_ROW_BYTES == 512 // 2 + 512 // 16
+    assert DEEPSEEK_V41_SWA_PAGE_SIZE == 32
+    assert deepseek_v41_mixed_sparse_workspace_size(1, 8, 512, 128) == (
+        1 * 40 * 8 * 512 * 2 + 1 * 40 * 8 * 4
+    )
+    assert deepseek_v41_mixed_sparse_workspace_size(64, 8, 512, 128) == 64 * 8 * 4
+    assert deepseek_v41_mixed_sparse_workspace_size(0, 8, 512, 128) == 0
+    upper_bound = deepseek_v41_mixed_sparse_workspace_size_upper_bound(
+        32, 8, 128, 512, 512
+    )
+    assert upper_bound == 155 * 8 * 512 * 2 + 155 * 8 * 4
+    for num_tokens in range(1, 33):
+        for swa_topk in range(128, 513, 31):
+            assert (
+                deepseek_v41_mixed_sparse_workspace_size(num_tokens, 8, swa_topk, 512)
+                <= upper_bound
+            )
+    decode_upper_bound = deepseek_v41_mixed_sparse_workspace_size_upper_bound(
+        1, 8, 128, 2048, 512
+    )
+    assert decode_upper_bound == 526336
+    for swa_topk in range(128, 2049):
+        assert (
+            deepseek_v41_mixed_sparse_workspace_size(1, 8, swa_topk, 512)
+            <= decode_upper_bound
+        )
