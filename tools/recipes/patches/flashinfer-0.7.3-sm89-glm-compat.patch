+    _check_last_dim_512(mid_out, "mid_out")
+
+    runner = _decode_dsv3_2_runner_singleton(int(model_type))
+    inputs = [
+        q,
+        indices,
+        mid_out,
+        mid_lse,
+        output,
+        out_lse,
+        topk_length,
+        attn_sink,
+    ]
+
+    forward_kwargs = {
+        "sm_scale": sm_scale,
+        "kv_cache": kv_cache,
+    }
+
+    if chunks_per_block is not None:
+        runner(
+            inputs=inputs,
+            tactic=int(chunks_per_block),
+            **forward_kwargs,
