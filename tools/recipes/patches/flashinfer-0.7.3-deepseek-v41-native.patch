+    swa_write_slots = torch.arange(swa_capacity, dtype=torch.int32, device=device)
+    global_write_slots = torch.arange(global_capacity, dtype=torch.int64, device=device)
+    deepseek_v41_pack_swa_cache(swa_kv, swa_write_slots, swa_cache)
+    deepseek_v41_pack_global_cache(global_kv, global_write_slots, global_cache)
+    swa_slots = torch.arange(topk, dtype=torch.int32, device=device)[None]
+    global_slots = torch.arange(topk, dtype=torch.int64, device=device)[None]
+    sinks = torch.linspace(-1, 1, num_heads, dtype=torch.float32, device=device)
+    out_backing = torch.full(
+        (num_tokens + 2, num_heads, 512),
+        123,
+        dtype=torch.bfloat16,
+        device=device,
+    )
+    out = out_backing[1:-1]
+    assert out.is_contiguous()
+    workspace = torch.empty(
