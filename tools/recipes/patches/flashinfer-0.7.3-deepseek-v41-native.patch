+def compile_deepseek_v41_mixed_sparse_ptx(
+    arch: int,
+    num_heads: int,
+    num_splits: int,
+    has_global: bool,
+    global_page_size: int,
+    unified_tiles: bool = False,
+    *,
+    block_n: int = BLOCK_KV,
+    num_warps: int = 8,
+    pipeline_stages: int = 2,
+) -> tuple[str, int]:
+    """Offline compile one main-kernel specialization for source auditing."""
+    compiled = triton.compile(
