+def sparse_mla_sm89_compat_decode_dsv3_2(
+    q: torch.Tensor,
+    kv_cache: torch.Tensor,
+    indices: torch.Tensor,
+    mid_out: torch.Tensor,
+    mid_lse: torch.Tensor,
+    output: torch.Tensor,
+    out_lse: torch.Tensor,
