diff --git a/csrc/deepseek_v41_attention.cu b/csrc/deepseek_v41_attention.cu
new file mode 100644
--- /dev/null
+++ b/csrc/deepseek_v41_attention.cu
@@ -0,0 +1,245 @@
+// Copyright (c) 2026 FlashInfer contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <flashinfer/attention/deepseek_v41_epilogue.cuh>
+#include <flashinfer/attention/deepseek_v41_mixed_sparse.cuh>
+
+#include "tvm_ffi_utils.h"
+
+namespace flashinfer::deepseek_v41 {
+
+namespace {
+
+void check_tensor(const TensorView& tensor, DLDataType dtype, int ndim, const TensorView& q,
+                  const char* name) {
+  CHECK_CUDA(tensor);
+  CHECK_DEVICE(q, tensor);
+  TVM_FFI_ICHECK_EQ(tensor.dtype(), dtype) << name << " has an invalid dtype";
+  TVM_FFI_ICHECK_EQ(tensor.ndim(), ndim) << name << " has an invalid rank";
+  CHECK_CONTIGUOUS(tensor);
+}
+
+void check_paged_layout(int64_t nbytes, int64_t page_size, int64_t page_stride, int64_t row_stride,
+                        int64_t payload_bytes, const char* name) {
+  TVM_FFI_ICHECK_GT(nbytes, 0) << name << " must contain storage";
+  TVM_FFI_ICHECK_GT(page_size, 0) << name << " page size must be positive";
+  TVM_FFI_ICHECK_GE(row_stride, payload_bytes) << name << " row stride is smaller than its payload";
+  TVM_FFI_ICHECK_LE(row_stride, INT64_MAX / page_size) << name << " page extent overflows int64";
+  TVM_FFI_ICHECK_GE(page_stride, page_size * row_stride) << name << " page stride overlaps rows";
+}
+
+size_t tensor_nbytes(const TensorView& tensor) {
+  const DLDataType dtype = tensor.dtype();
+  return static_cast<size_t>(tensor.numel()) * dtype.bits * dtype.lanes / 8;
+}
+
+bool tensors_overlap(const TensorView& lhs, const TensorView& rhs) {
+  const size_t lhs_bytes = tensor_nbytes(lhs);
+  const size_t rhs_bytes = tensor_nbytes(rhs);
+  if (lhs_bytes == 0 || rhs_bytes == 0) return false;
+  const auto lhs_begin = reinterpret_cast<uintptr_t>(lhs.data_ptr());
+  const auto rhs_begin = reinterpret_cast<uintptr_t>(rhs.data_ptr());
+  if (lhs_begin <= rhs_begin) {
+    return rhs_begin - lhs_begin < lhs_bytes;
+  }
+  return lhs_begin - rhs_begin < rhs_bytes;
+}
+
+void check_no_overlap(const TensorView& output, const TensorView& operand, const char* name) {
+  TVM_FFI_ICHECK(!tensors_overlap(output, operand)) << "grouped_out must not overlap " << name;
+}
+
+template <typename SwaSlotT, typename GlobalSlotT>
+void launch_attention(const V41AttentionParams& params, TensorView out, cudaStream_t stream) {
+  const cudaError_t status = launch_deepseek_v41_attention<SwaSlotT, GlobalSlotT>(
+      params, static_cast<bf16*>(out.data_ptr()), out.stride(0), out.stride(1), stream);
+  TVM_FFI_ICHECK_EQ(status, cudaSuccess)
+      << "DeepSeek-V4.1 native attention launch failed: " << cudaGetErrorString(status);
+}
+
+}  // namespace
+
+void AttentionImpl(TensorView q, TensorView swa_cache, TensorView global_cache,
+                   TensorView swa_slots, TensorView global_slots, TensorView sinks,
+                   TensorView partial_out, TensorView partial_lse, TensorView out, double sm_scale,
+                   int64_t num_splits, bool has_global, bool unified_tiles, int64_t swa_page_size,
+                   int64_t swa_page_stride, int64_t swa_row_stride, int64_t global_page_size,
+                   int64_t global_page_stride, int64_t global_row_stride,
+                   V41EpilogueParams epilogue = {}) {
+  check_tensor(q, dl_bfloat16, 3, q, "q");
+  check_tensor(swa_cache, dl_uint8, 1, q, "swa_cache");
+  check_tensor(global_cache, dl_uint8, 1, q, "global_cache");
+  check_tensor(swa_slots, swa_slots.dtype(), 2, q, "swa_slots");
+  CHECK_CUDA(global_slots);
+  CHECK_DEVICE(q, global_slots);
+  TVM_FFI_ICHECK_EQ(global_slots.ndim(), 2) << "global_slots has an invalid rank";
+  check_tensor(sinks, dl_float32, 1, q, "sinks");
+  check_tensor(partial_out, dl_bfloat16, 4, q, "partial_out");
+  check_tensor(partial_lse, dl_float32, 3, q, "partial_lse");
+  check_tensor(out, dl_bfloat16, 3, q, "out");
+
+  TVM_FFI_ICHECK(swa_slots.dtype() == dl_int32 || swa_slots.dtype() == dl_int64)
+      << "swa_slots must be int32 or int64";
+  TVM_FFI_ICHECK(global_slots.dtype() == dl_int32 || global_slots.dtype() == dl_int64)
+      << "global_slots must be int32 or int64";
+  if (has_global) CHECK_CONTIGUOUS(global_slots);
+  TVM_FFI_ICHECK_EQ(q.size(2), kV41Dim) << "q must have head dimension 512";
+  TVM_FFI_ICHECK(q.size(1) == 8 || q.size(1) == 16 || q.size(1) == 32)
+      << "q head count must be 8, 16, or 32";
+  TVM_FFI_ICHECK_GT(q.size(0), 0) << "q must contain at least one token";
+  TVM_FFI_ICHECK_EQ(q.stride(2), 1) << "q head dimension must be contiguous";
+  TVM_FFI_ICHECK_EQ(swa_slots.size(0), q.size(0));
+  TVM_FFI_ICHECK_EQ(global_slots.size(0), q.size(0));
+  TVM_FFI_ICHECK_EQ(sinks.size(0), q.size(1));
+  TVM_FFI_ICHECK_GE(swa_slots.size(1), 0);
+  TVM_FFI_ICHECK_EQ(has_global, global_slots.size(1) > 0) << "has_global must match global_slots";
+  TVM_FFI_ICHECK_GE(num_splits, 1);
+  TVM_FFI_ICHECK_LE(num_splits, kV41MaxSplits);
+  TVM_FFI_ICHECK(!unified_tiles || has_global) << "unified scheduling requires the global cache";
+
+  TVM_FFI_ICHECK_EQ(partial_out.size(0), q.size(0));
+  TVM_FFI_ICHECK_EQ(partial_out.size(1), num_splits);
+  TVM_FFI_ICHECK_EQ(partial_out.size(2), q.size(1));
+  TVM_FFI_ICHECK_EQ(partial_out.size(3), kV41Dim);
+  TVM_FFI_ICHECK_EQ(partial_lse.size(0), q.size(0));
+  TVM_FFI_ICHECK_EQ(partial_lse.size(1), num_splits);
+  TVM_FFI_ICHECK_EQ(partial_lse.size(2), q.size(1));
+  TVM_FFI_ICHECK_EQ(out.size(0), q.size(0));
+  TVM_FFI_ICHECK_EQ(out.size(1), q.size(1));
+  TVM_FFI_ICHECK_EQ(out.size(2), kV41Dim);
+
+  TVM_FFI_ICHECK_EQ(swa_page_size, 32);
+  check_paged_layout(swa_cache.numel(), swa_page_size, swa_page_stride, swa_row_stride,
+                     kV41SwaPayloadBytes, "swa_cache");
+  if (has_global) {
+    TVM_FFI_ICHECK(global_page_size == 64 || global_page_size == 128)
+        << "global page size must be 64 or 128";
+    check_paged_layout(global_cache.numel(), global_page_size, global_page_stride,
+                       global_row_stride, kV41GlobalPayloadBytes, "global_cache");
+  }
+
+  V41AttentionParams params{static_cast<const bf16*>(q.data_ptr()),
+                            static_cast<const uint8_t*>(swa_cache.data_ptr()),
+                            static_cast<const uint8_t*>(global_cache.data_ptr()),
+                            swa_slots.data_ptr(),
+                            global_slots.data_ptr(),
+                            static_cast<const float*>(sinks.data_ptr()),
+                            static_cast<bf16*>(partial_out.data_ptr()),
+                            static_cast<float*>(partial_lse.data_ptr()),
+                            q.stride(0),
+                            q.stride(1),
+                            swa_slots.stride(0),
+                            global_slots.stride(0),
+                            partial_out.stride(0),
+                            partial_out.stride(1),
+                            partial_out.stride(2),
+                            partial_lse.stride(0),
+                            partial_lse.stride(1),
+                            partial_lse.stride(2),
+                            swa_cache.numel(),
+                            global_cache.numel(),
+                            swa_page_stride,
+                            swa_row_stride,
+                            global_page_stride,
+                            global_row_stride,
+                            static_cast<int>(swa_page_size),
+                            static_cast<int>(global_page_size),
+                            static_cast<int>(swa_slots.size(1)),
+                            static_cast<int>(global_slots.size(1)),
+                            static_cast<int>(q.size(0)),
+                            static_cast<int>(q.size(1)),
+                            static_cast<int>(num_splits),
+                            static_cast<float>(sm_scale),
+                            has_global,
+                            unified_tiles,
+                            epilogue};
+
+  ffi::CUDADeviceGuard guard(q.device().device_id);
+  const cudaStream_t stream = get_stream(q.device());
+  if (swa_slots.dtype() == dl_int32) {
+    if (global_slots.dtype() == dl_int32) {
+      launch_attention<int32_t, int32_t>(params, out, stream);
+    } else {
+      launch_attention<int32_t, int64_t>(params, out, stream);
+    }
+  } else if (global_slots.dtype() == dl_int32) {
+    launch_attention<int64_t, int32_t>(params, out, stream);
+  } else {
+    launch_attention<int64_t, int64_t>(params, out, stream);
+  }
+}
+
+void Attention(TensorView q, TensorView swa_cache, TensorView global_cache, TensorView swa_slots,
+               TensorView global_slots, TensorView sinks, TensorView partial_out,
+               TensorView partial_lse, TensorView out, double sm_scale, int64_t num_splits,
+               bool has_global, bool unified_tiles, int64_t swa_page_size, int64_t swa_page_stride,
+               int64_t swa_row_stride, int64_t global_page_size, int64_t global_page_stride,
+               int64_t global_row_stride) {
+  AttentionImpl(q, swa_cache, global_cache, swa_slots, global_slots, sinks, partial_out,
+                partial_lse, out, sm_scale, num_splits, has_global, unified_tiles, swa_page_size,
+                swa_page_stride, swa_row_stride, global_page_size, global_page_stride,
+                global_row_stride);
+}
+
+void AttentionWithInvRope(TensorView q, TensorView swa_cache, TensorView global_cache,
+                          TensorView swa_slots, TensorView global_slots, TensorView sinks,
+                          TensorView partial_out, TensorView partial_lse, TensorView out,
+                          double sm_scale, int64_t num_splits, bool has_global, bool unified_tiles,
+                          int64_t swa_page_size, int64_t swa_page_stride, int64_t swa_row_stride,
+                          int64_t global_page_size, int64_t global_page_stride,
+                          int64_t global_row_stride, TensorView positions, TensorView cos_sin,
+                          TensorView grouped_out, int64_t token_offset) {
+  check_tensor(positions, dl_int64, 1, q, "positions");
+  check_tensor(cos_sin, dl_float32, 2, q, "cos_sin");
+  check_tensor(grouped_out, dl_bfloat16, 3, q, "grouped_out");
+  TVM_FFI_ICHECK_EQ(positions.size(0), q.size(0))
+      << "positions must have one entry per query token";
+  TVM_FFI_ICHECK_GT(cos_sin.size(0), 0) << "cos_sin must contain at least one position";
+  TVM_FFI_ICHECK_EQ(cos_sin.size(1), 64) << "cos_sin must have shape [L, 64]";
+  TVM_FFI_ICHECK_GT(grouped_out.size(0), 0) << "grouped_out must contain at least one group";
+  TVM_FFI_ICHECK_EQ(q.size(1) % grouped_out.size(0), 0)
+      << "q heads must divide evenly across grouped_out";
+  const int64_t heads_per_group = q.size(1) / grouped_out.size(0);
+  TVM_FFI_ICHECK_EQ(heads_per_group, 8)
+      << "fused inverse RoPE currently requires eight heads per group";
+  TVM_FFI_ICHECK_EQ(grouped_out.size(2), heads_per_group * kV41Dim)
+      << "grouped_out has an invalid grouped head dimension";
+  TVM_FFI_ICHECK_GE(token_offset, 0) << "token_offset must be non-negative";
+  TVM_FFI_ICHECK_LE(token_offset, grouped_out.size(1))
+      << "token_offset exceeds grouped_out token capacity";
+  TVM_FFI_ICHECK_LE(q.size(0), grouped_out.size(1) - token_offset)
+      << "query tokens exceed grouped_out token capacity";
+
+  check_no_overlap(grouped_out, q, "q");
+  check_no_overlap(grouped_out, swa_cache, "swa_cache");
+  check_no_overlap(grouped_out, global_cache, "global_cache");
+  check_no_overlap(grouped_out, swa_slots, "swa_slots");
+  check_no_overlap(grouped_out, global_slots, "global_slots");
+  check_no_overlap(grouped_out, sinks, "sinks");
+  if (num_splits > 1) {
+    check_no_overlap(grouped_out, partial_out, "partial_out");
+  }
+  check_no_overlap(grouped_out, partial_lse, "partial_lse");
+  check_no_overlap(grouped_out, positions, "positions");
+  check_no_overlap(grouped_out, cos_sin, "cos_sin");
+
+  V41EpilogueParams epilogue{static_cast<const int64_t*>(positions.data_ptr()),
+                             static_cast<const float*>(cos_sin.data_ptr()),
+                             static_cast<bf16*>(grouped_out.data_ptr()),
+                             cos_sin.stride(0),
+                             cos_sin.size(0),
+                             grouped_out.size(1),
+                             token_offset,
+                             static_cast<int>(heads_per_group)};
+  AttentionImpl(q, swa_cache, global_cache, swa_slots, global_slots, sinks, partial_out,
+                partial_lse, out, sm_scale, num_splits, has_global, unified_tiles, swa_page_size,
+                swa_page_stride, swa_row_stride, global_page_size, global_page_stride,
+                global_row_stride, epilogue);
+}
+
+}  // namespace flashinfer::deepseek_v41
+
+TVM_FFI_DLL_EXPORT_TYPED_FUNC(deepseek_v41_mixed_sparse_attention,
+                              flashinfer::deepseek_v41::Attention);
+TVM_FFI_DLL_EXPORT_TYPED_FUNC(deepseek_v41_mixed_sparse_attention_with_inv_rope,
+                              flashinfer::deepseek_v41::AttentionWithInvRope);
diff --git a/csrc/deepseek_v41_cache.cu b/csrc/deepseek_v41_cache.cu
new file mode 100644
--- /dev/null
+++ b/csrc/deepseek_v41_cache.cu
@@ -0,0 +1,200 @@
+// Copyright (c) 2026 FlashInfer contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cuda_bf16.h>
+#include <cuda_fp8.h>
+#include <cuda_runtime.h>
+
+#include "tvm_ffi_utils.h"
+
+namespace flashinfer::deepseek_v41 {
+
+constexpr int kDim = 512;
+constexpr int kSwaGroup = 32;
+constexpr int kGlobalGroup = 16;
+constexpr int kSwaRowBytes = 528;
+constexpr int kGlobalRowBytes = 288;
+constexpr float kFp8Max = 448.0f;
+constexpr float kFp4Max = 6.0f;
+
+__device__ __forceinline__ float warp_absmax(float x) {
+#pragma unroll
+  for (int delta = 16; delta > 0; delta >>= 1) {
+    x = fmaxf(x, __shfl_down_sync(0xffffffff, x, delta));
+  }
+  return __shfl_sync(0xffffffff, x, 0);
+}
+
+__device__ __forceinline__ float ceil_pow2(float x) {
+  uint32_t bits = __float_as_uint(x);
+  if (bits & 0x007fffffU) bits = (bits + 0x00800000U) & 0x7f800000U;
+  return __uint_as_float(bits);
+}
+
+__device__ __forceinline__ uint8_t fp8_bits(float x) {
+  __nv_fp8_e4m3 v(x);
+  return v.__x;
+}
+
+// Software E2M1 RNE is used on both Ada and Blackwell.  The alternating
+// strict/non-strict boundaries implement ties-to-even for the representable
+// magnitudes 0, .5, 1, 1.5, 2, 3, 4, and 6.
+__device__ __forceinline__ uint8_t fp4_bits(float x) {
+  const bool negative = signbit(x);
+  const float a = fminf(fabsf(x), kFp4Max);
+  uint8_t code;
+  if (a <= 0.25f)
+    code = 0;
+  else if (a < 0.75f)
+    code = 1;
+  else if (a <= 1.25f)
+    code = 2;
+  else if (a < 1.75f)
+    code = 3;
+  else if (a <= 2.5f)
+    code = 4;
+  else if (a < 3.5f)
+    code = 5;
+  else if (a <= 5.0f)
+    code = 6;
+  else
+    code = 7;
+  return code | (negative ? 0x8 : 0);
+}
+
+template <typename SlotT>
+__global__ void pack_swa_kernel(const __nv_bfloat16* __restrict__ kv,
+                                const SlotT* __restrict__ slots,
+                                uint8_t* __restrict__ cache, int num_tokens,
+                                int64_t kv_stride, int64_t cache_nbytes,
+                                int page_size, int64_t page_stride,
+                                int64_t row_stride) {
+  const int token = blockIdx.x;
+  const int group = blockIdx.y;
+  const int lane = threadIdx.x;
+  if (token >= num_tokens) return;
+  const int64_t slot = static_cast<int64_t>(slots[token]);
+  const int64_t row_offset = (slot / page_size) * page_stride +
+                             (slot % page_size) * row_stride;
+  if (slot < 0 || row_offset < 0 || row_offset + kSwaRowBytes > cache_nbytes) return;
+
+  const int d = group * kSwaGroup + lane;
+  const float x = __bfloat162float(kv[token * kv_stride + d]);
+  const float amax = warp_absmax(fabsf(x));
+  const float scale = ceil_pow2(fmaxf(amax, 1.0e-4f) / kFp8Max);
+  uint8_t* row = cache + row_offset;
+  const float scaled = __fdiv_rn(x, scale);
+  row[d] = fp8_bits(fmaxf(-kFp8Max, fminf(kFp8Max, scaled)));
+  if (lane == 0) row[kDim + group] = (__float_as_uint(scale) >> 23) & 0xff;
+}
+
+template <typename SlotT>
+__global__ void pack_global_kernel(const __nv_bfloat16* __restrict__ kv,
+                                   const SlotT* __restrict__ slots,
+                                   uint8_t* __restrict__ cache, int num_tokens,
+                                   int64_t kv_stride, int64_t cache_nbytes,
+                                   int page_size, int64_t page_stride,
+                                   int64_t row_stride) {
+  const int token = blockIdx.x;
+  const int group = blockIdx.y;
+  const int lane = threadIdx.x;
+  if (token >= num_tokens) return;
+  const int64_t slot = static_cast<int64_t>(slots[token]);
+  const int64_t row_offset = (slot / page_size) * page_stride +
+                             (slot % page_size) * row_stride;
+  if (slot < 0 || row_offset < 0 || row_offset + kGlobalRowBytes > cache_nbytes) return;
+
+  const int d = group * kGlobalGroup + lane;
+  float x = lane < kGlobalGroup
+                ? __bfloat162float(kv[token * kv_stride + d])
+                : 0.0f;
+  const float amax = warp_absmax(fabsf(x));
+  const float raw_scale = fmaxf(amax, kFp4Max * 0x1p-9f) / kFp4Max;
+  const uint8_t scale_bits = fp8_bits(raw_scale);
+  const __nv_fp8_e4m3 scale_fp8 = *reinterpret_cast<const __nv_fp8_e4m3*>(&scale_bits);
+  const float scale = static_cast<float>(scale_fp8);
+  uint8_t* row = cache + row_offset;
+  if (lane < kGlobalGroup / 2) {
+    const int d0 = group * kGlobalGroup + lane * 2;
+    const float x0 = __bfloat162float(kv[token * kv_stride + d0]);
+    const float x1 = __bfloat162float(kv[token * kv_stride + d0 + 1]);
+    row[d0 / 2] = fp4_bits(__fdiv_rn(x0, scale)) |
+                  (fp4_bits(__fdiv_rn(x1, scale)) << 4);
+  }
+  if (lane == 0) row[kDim / 2 + group] = scale_bits;
+}
+
+template <typename SlotT>
+void launch_swa(TensorView kv, TensorView slots, TensorView cache, int page_size,
+                int64_t page_stride, int64_t row_stride, cudaStream_t stream) {
+  pack_swa_kernel<<<dim3(slots.size(0), kDim / kSwaGroup), 32, 0, stream>>>(
+      static_cast<const __nv_bfloat16*>(kv.data_ptr()),
+      static_cast<const SlotT*>(slots.data_ptr()), static_cast<uint8_t*>(cache.data_ptr()),
+      static_cast<int>(slots.size(0)), kv.stride(0), cache.numel(), page_size,
+      page_stride, row_stride);
+}
+
+template <typename SlotT>
+void launch_global(TensorView kv, TensorView slots, TensorView cache, int page_size,
+                   int64_t page_stride, int64_t row_stride, cudaStream_t stream) {
+  pack_global_kernel<<<dim3(slots.size(0), kDim / kGlobalGroup), 32, 0, stream>>>(
+      static_cast<const __nv_bfloat16*>(kv.data_ptr()),
+      static_cast<const SlotT*>(slots.data_ptr()), static_cast<uint8_t*>(cache.data_ptr()),
+      static_cast<int>(slots.size(0)), kv.stride(0), cache.numel(), page_size,
+      page_stride, row_stride);
+}
+
+template <bool Global>
+void pack_cache(TensorView kv, TensorView slots, TensorView cache, int64_t page_size,
+                int64_t page_stride, int64_t row_stride) {
+  CHECK_CUDA(kv);
+  CHECK_CUDA(slots);
+  CHECK_CUDA(cache);
+  CHECK_DEVICE(kv, slots);
+  CHECK_DEVICE(kv, cache);
+  TVM_FFI_ICHECK_EQ(kv.dtype(), dl_bfloat16) << "kv must be bfloat16";
+  TVM_FFI_ICHECK(slots.dtype() == dl_int32 || slots.dtype() == dl_int64)
+      << "slots must be int32 or int64";
+  TVM_FFI_ICHECK_EQ(cache.dtype(), dl_uint8) << "cache must be uint8";
+  TVM_FFI_ICHECK_EQ(kv.ndim(), 2) << "kv must be [T, 512]";
+  TVM_FFI_ICHECK_EQ(kv.size(1), kDim) << "kv must be [T, 512]";
+  TVM_FFI_ICHECK_EQ(kv.stride(1), 1) << "kv inner dimension must be contiguous";
+  TVM_FFI_ICHECK_EQ(slots.ndim(), 1) << "slots must be [T]";
+  TVM_FFI_ICHECK_LE(slots.size(0), kv.size(0));
+  constexpr int kPayload = Global ? kGlobalRowBytes : kSwaRowBytes;
+  TVM_FFI_ICHECK_GT(page_size, 0);
+  TVM_FFI_ICHECK_GE(row_stride, kPayload);
+  TVM_FFI_ICHECK_GE(page_stride, page_size * row_stride);
+  if (slots.size(0) == 0) return;
+  ffi::CUDADeviceGuard guard(kv.device().device_id);
+  const cudaStream_t stream = get_stream(kv.device());
+  if (slots.dtype() == dl_int32) {
+    if constexpr (Global)
+      launch_global<int32_t>(kv, slots, cache, page_size, page_stride, row_stride, stream);
+    else
+      launch_swa<int32_t>(kv, slots, cache, page_size, page_stride, row_stride, stream);
+  } else {
+    if constexpr (Global)
+      launch_global<int64_t>(kv, slots, cache, page_size, page_stride, row_stride, stream);
+    else
+      launch_swa<int64_t>(kv, slots, cache, page_size, page_stride, row_stride, stream);
+  }
+  TVM_FFI_ICHECK_EQ(cudaPeekAtLastError(), cudaSuccess) << "DeepSeek-V4.1 cache pack failed";
+}
+
+void PackSwa(TensorView kv, TensorView slots, TensorView cache, int64_t page_size,
+             int64_t page_stride, int64_t row_stride) {
+  pack_cache<false>(kv, slots, cache, page_size, page_stride, row_stride);
+}
+
+void PackGlobal(TensorView kv, TensorView slots, TensorView cache, int64_t page_size,
+                int64_t page_stride, int64_t row_stride) {
+  pack_cache<true>(kv, slots, cache, page_size, page_stride, row_stride);
+}
+
+}  // namespace flashinfer::deepseek_v41
+
+TVM_FFI_DLL_EXPORT_TYPED_FUNC(deepseek_v41_pack_swa_cache,
+                              flashinfer::deepseek_v41::PackSwa);
+TVM_FFI_DLL_EXPORT_TYPED_FUNC(deepseek_v41_pack_global_cache,
+                              flashinfer::deepseek_v41::PackGlobal);
